---
// src/components/CartDrawer.astro
---

<div id="cartDrawerBackdrop" class="fixed inset-0 z-50 bg-briella-charcoal/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300" role="dialog" aria-modal="true" aria-hidden="true">
  <div id="cartDrawerPanel" class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white sm:rounded-l-3xl border-l border-briella-cream-dark shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300">
    
    <!-- ============================================== -->
    <!-- STEP 1: RESUMEN DE BOLSA DE COMPRAS            -->
    <!-- ============================================== -->
    <div id="cartStep1Container" class="flex flex-col h-full justify-between">
      
      <!-- Step 1 Header -->
      <div class="p-4 sm:p-5 border-b border-briella-cream-dark flex items-center justify-between bg-briella-cream-light sm:rounded-tl-3xl">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-briella-blue stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <div>
            <h2 class="font-serif text-lg sm:text-xl font-medium text-briella-charcoal leading-none">Mi Pedido Briella</h2>
            <span class="text-[10px] text-briella-charcoal/60 font-semibold tracking-wider uppercase">Paso 1 de 2: Productos</span>
          </div>
        </div>

        <button class="btn-cart-close w-8 h-8 rounded-full bg-white border border-briella-cream-dark flex items-center justify-center text-briella-charcoal hover:bg-briella-charcoal hover:text-white transition-colors" aria-label="Cerrar carrito">
          <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Step 1 Items List -->
      <div id="cartItemsList" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3">
        <!-- Injected dynamically by Client Script -->
      </div>

      <!-- Step 1 Footer (Subtotal + Go to Step 2 Button) -->
      <div id="cartStep1Footer" class="hidden p-4 sm:p-6 border-t border-briella-cream-dark bg-briella-cream sm:rounded-bl-3xl space-y-3">
        
        <!-- Subtotal Row -->
        <div class="flex items-baseline justify-between bg-white p-3.5 rounded-2xl border border-briella-cream-dark shadow-xs">
          <span class="text-xs font-bold uppercase tracking-widest text-briella-charcoal/70">Subtotal Estimado:</span>
          <span id="cartStep1Subtotal" class="text-xl font-bold font-sans text-briella-charcoal">S/ 0.00</span>
        </div>

        <p class="text-[11px] text-center text-briella-charcoal/60">
          Envíos a todo el Perú &bull; Plata Ley 950 &bull; Oro 18k
        </p>

        <!-- Continue to Step 2 Button -->
        <button 
          id="btnCartGoToStep2" 
          type="button"
          class="w-full bg-briella-blue hover:bg-briella-blue-dark active:scale-[0.98] text-white py-3.5 px-4 rounded-2xl text-xs font-bold uppercase tracking-widest transition-all shadow-md flex items-center justify-center gap-2"
        >
          <span>Continuar con mi Pedido</span>
          <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

      </div>

    </div>


    <!-- ============================================== -->
    <!-- STEP 2: DATOS DE ENVÍO & CONFIRMACIÓN          -->
    <!-- ============================================== -->
    <div id="cartStep2Container" class="hidden flex-col h-full justify-between">
      
      <!-- Step 2 Header -->
      <div class="p-4 sm:p-5 border-b border-briella-cream-dark flex items-center justify-between bg-briella-cream-light sm:rounded-tl-3xl">
        <div class="flex items-center gap-2">
          <!-- Back to Step 1 Button -->
          <button 
            id="btnCartBackToStep1" 
            type="button"
            class="w-8 h-8 rounded-full bg-white border border-briella-cream-dark flex items-center justify-center text-briella-charcoal hover:bg-briella-cream active:scale-95 transition-all"
            aria-label="Volver a la bolsa"
            title="Volver"
          >
            <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>

          <div>
            <h2 class="font-serif text-lg sm:text-xl font-medium text-briella-charcoal leading-none">Datos de Envío</h2>
            <span class="text-[10px] text-briella-blue font-bold tracking-wider uppercase">Paso 2 de 2: Confirmación</span>
          </div>
        </div>

        <button class="btn-cart-close w-8 h-8 rounded-full bg-white border border-briella-cream-dark flex items-center justify-center text-briella-charcoal hover:bg-briella-charcoal hover:text-white transition-colors" aria-label="Cerrar carrito">
          <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Step 2 Content / Form Fields -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4">
        
        <!-- Compact Summary Box -->
        <div class="bg-briella-cream rounded-2xl border border-briella-cream-dark p-3.5 flex items-center justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-briella-charcoal/60 block">Total de tu Pedido:</span>
            <span id="cartStep2ItemsCount" class="text-xs text-briella-blue font-semibold">1 joya en tu bolsa</span>
          </div>
          <span id="cartStep2Subtotal" class="text-lg font-bold font-sans text-briella-charcoal">S/ 0.00</span>
        </div>

        <!-- Form Fields -->
        <div class="space-y-3">
          <div class="text-[11px] font-bold uppercase tracking-wider text-briella-charcoal/80 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-briella-blue stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Ingresa tus datos para la entrega:</span>
          </div>

          <div>
            <label for="cartInputCustomerName" class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1">Nombre y Apellidos *</label>
            <input 
              type="text" 
              id="cartInputCustomerName" 
              placeholder="Ej. Camila Morales" 
              required
              class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-xl border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none transition-colors"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label for="cartInputCustomerDni" class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1">DNI / Doc *</label>
              <input 
                type="text" 
                id="cartInputCustomerDni" 
                placeholder="DNI o Cédula" 
                maxlength="12"
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-xl border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none transition-colors"
              />
            </div>
            <div>
              <label for="cartInputCustomerCity" class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1">Ciudad / Distrito *</label>
              <input 
                type="text" 
                id="cartInputCustomerCity" 
                placeholder="Ej. Miraflores, Lima" 
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-xl border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="cartInputCustomerAddress" class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1">Dirección de Entrega *</label>
            <input 
              type="text" 
              id="cartInputCustomerAddress" 
              placeholder="Av. / Calle, Nro, Dpto / Referencia" 
              required
              class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-xl border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none transition-colors"
            />
          </div>

          <div>
            <label for="cartInputCustomerNotes" class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1">Nota o Dedicatoria (Opcional)</label>
            <input 
              type="text" 
              id="cartInputCustomerNotes" 
              placeholder="Ej. Para regalo de aniversario / Nota especial" 
              class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-xl border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none transition-colors"
            />
          </div>

          <!-- Payment Methods Banner -->
          <div class="p-3 rounded-xl bg-briella-cream-light border border-briella-cream-dark flex items-center justify-between text-[11px] text-briella-charcoal/80">
            <span class="font-bold">Medios de pago aceptados:</span>
            <div class="flex items-center gap-1.5 font-semibold text-xs">
              <span class="px-2 py-0.5 bg-white rounded-md border border-briella-cream-dark text-[10px]">Yape</span>
              <span class="px-2 py-0.5 bg-white rounded-md border border-briella-cream-dark text-[10px]">Plin</span>
              <span class="px-2 py-0.5 bg-white rounded-md border border-briella-cream-dark text-[10px]">BCP/BBVA</span>
            </div>
          </div>

          <p id="cartFormError" class="hidden text-[11px] text-red-600 font-bold bg-red-50 p-2.5 rounded-xl border border-red-200">
            Por favor ingresa tu Nombre, DNI y Dirección de entrega.
          </p>

        </div>

      </div>

      <!-- Step 2 Footer (Send WhatsApp Button) -->
      <div class="p-4 sm:p-6 border-t border-briella-cream-dark bg-briella-cream sm:rounded-bl-3xl space-y-2">
        <button 
          id="btnWhatsAppCheckoutSubmit" 
          type="button"
          class="w-full bg-briella-whatsapp hover:bg-briella-whatsapp-dark active:scale-[0.98] text-white py-3.5 px-4 rounded-2xl text-xs font-bold uppercase tracking-widest transition-all shadow-wa flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7 8.98 7 10.21C7 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"/>
          </svg>
          <span>Enviar Pedido por WhatsApp</span>
        </button>

        <p class="text-[10px] text-center text-briella-charcoal/60">
          Atención directa y confirmación de stock inmediata por WhatsApp.
        </p>
      </div>

    </div>

  </div>
</div>

<script is:inline>
  window.BriellaCartClient = {
    items: [],
    waNumber: '51923340617',
    currentStep: 1,

    init() {
      this.load();
      this.bind();
      this.render();
    },

    load() {
      try {
        const saved = localStorage.getItem('briella_cart_astro_v1');
        if (saved) this.items = JSON.parse(saved);
      } catch (e) {
        this.items = [];
      }
    },

    save() {
      try {
        localStorage.setItem('briella_cart_astro_v1', JSON.stringify(this.items));
      } catch (e) {}
    },

    bind() {
      const trigger = document.getElementById('btnCartTrigger');
      const backdrop = document.getElementById('cartDrawerBackdrop');
      const closeButtons = document.querySelectorAll('.btn-cart-close');
      const btnGoStep2 = document.getElementById('btnCartGoToStep2');
      const btnBackStep1 = document.getElementById('btnCartBackToStep1');
      const submitBtn = document.getElementById('btnWhatsAppCheckoutSubmit');

      if (trigger) trigger.addEventListener('click', () => this.open());
      closeButtons.forEach(btn => btn.addEventListener('click', () => this.close()));
      
      if (backdrop) {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop) this.close();
        });
      }

      if (btnGoStep2) {
        btnGoStep2.addEventListener('click', () => this.setStep(2));
      }

      if (btnBackStep1) {
        btnBackStep1.addEventListener('click', () => this.setStep(1));
      }

      if (submitBtn) {
        submitBtn.addEventListener('click', () => this.sendOrder());
      }

      // Bind all card Add buttons
      document.querySelectorAll('.btn-add-to-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const product = JSON.parse(btn.dataset.productJson || '{}');
          if (product.id) {
            this.addItem(product, 1);
          }
        });
      });
    },

    setStep(step) {
      this.currentStep = step;
      const step1 = document.getElementById('cartStep1Container');
      const step2 = document.getElementById('cartStep2Container');
      const errEl = document.getElementById('cartFormError');
      if (errEl) errEl.classList.add('hidden');

      if (step === 1) {
        if (step1) {
          step1.classList.remove('hidden');
          step1.classList.add('flex');
        }
        if (step2) {
          step2.classList.add('hidden');
          step2.classList.remove('flex');
        }
      } else {
        if (step1) {
          step1.classList.add('hidden');
          step1.classList.remove('flex');
        }
        if (step2) {
          step2.classList.remove('hidden');
          step2.classList.add('flex');
        }
      }
    },

    open() {
      const backdrop = document.getElementById('cartDrawerBackdrop');
      const panel = document.getElementById('cartDrawerPanel');
      this.setStep(1);
      if (backdrop && panel) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        panel.classList.remove('translate-x-full');
        panel.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
        this.render();
      }
    },

    close() {
      const backdrop = document.getElementById('cartDrawerBackdrop');
      const panel = document.getElementById('cartDrawerPanel');
      if (backdrop && panel) {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        panel.classList.add('translate-x-full');
        panel.classList.remove('translate-x-0');
        document.body.style.overflow = '';
      }
    },

    addItem(product, qty = 1, customNote = '') {
      const idx = this.items.findIndex(
        it => it.id === product.id && it.customNote === customNote
      );

      if (idx > -1) {
        this.items[idx].qty += qty;
      } else {
        this.items.push({
          id: product.id,
          nombre: product.nombre,
          material: product.material,
          precio: product.precio,
          imagen: product.imagen,
          qty,
          customNote
        });
      }

      this.save();
      this.render();
      this.showToast(`Añadido a tu bolsa: "${product.nombre}"`);
    },

    updateQty(index, qty) {
      if (qty <= 0) {
        this.removeItem(index);
        return;
      }
      if (this.items[index]) {
        this.items[index].qty = qty;
        this.save();
        this.render();
      }
    },

    removeItem(index) {
      if (this.items[index]) {
        const removed = this.items.splice(index, 1);
        this.save();
        this.render();
        if (removed.length) {
          this.showToast(`Se eliminó "${removed[0].nombre}"`);
        }
      }
    },

    render() {
      const badge = document.getElementById('cartBadgeCount');
      const mobileBarBadge = document.getElementById('mobileBarCartBadge');
      const headerTotal = document.getElementById('headerCartTotalText');
      const list = document.getElementById('cartItemsList');
      const step1Footer = document.getElementById('cartStep1Footer');
      const step1Subtotal = document.getElementById('cartStep1Subtotal');
      const step2Subtotal = document.getElementById('cartStep2Subtotal');
      const step2Count = document.getElementById('cartStep2ItemsCount');

      const totalCount = this.items.reduce((s, it) => s + it.qty, 0);
      const subtotal = this.items.reduce((s, it) => s + (it.precio * it.qty), 0);

      if (badge) badge.textContent = totalCount;
      if (mobileBarBadge) mobileBarBadge.textContent = totalCount;
      if (headerTotal) headerTotal.textContent = `S/ ${subtotal.toFixed(2)}`;
      if (step1Subtotal) step1Subtotal.textContent = `S/ ${subtotal.toFixed(2)}`;
      if (step2Subtotal) step2Subtotal.textContent = `S/ ${subtotal.toFixed(2)}`;
      if (step2Count) {
        step2Count.textContent = `${totalCount} joya${totalCount === 1 ? '' : 's'} en tu pedido`;
      }

      if (!list) return;

      if (this.items.length === 0) {
        this.setStep(1);
        list.innerHTML = `
          <div class="text-center py-16 text-briella-charcoal/60 space-y-3">
            <div class="w-14 h-14 rounded-full bg-briella-cream flex items-center justify-center mx-auto text-briella-blue/60">
              <svg class="w-7 h-7 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </div>
            <h4 class="font-serif text-lg font-medium text-briella-charcoal">Tu bolsa está vacía</h4>
            <p class="text-xs text-briella-charcoal/60 max-w-xs mx-auto">Explora nuestras colecciones en Plata 950 y Oro 18k para comenzar.</p>
          </div>
        `;
        if (step1Footer) step1Footer.classList.add('hidden');
        return;
      }

      if (step1Footer) step1Footer.classList.remove('hidden');

      list.innerHTML = this.items.map((it, idx) => `
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-white border border-briella-cream-dark shadow-xs">
          <img src="${it.imagen}" alt="${it.nombre}" class="w-14 h-14 object-cover rounded-xl border border-briella-cream-dark bg-[#FAF8F5] flex-shrink-0" />
          
          <div class="flex-1 min-w-0">
            <h4 class="font-serif text-sm font-medium text-briella-charcoal truncate">${it.nombre}</h4>
            <span class="text-[10px] text-briella-blue font-bold uppercase tracking-wider block">${it.material}</span>
            ${it.customNote ? `<span class="text-[10px] bg-briella-lavender text-briella-lavender-dark px-2 py-0.5 rounded-md inline-block my-0.5 font-medium">Grabado: "${it.customNote}"</span>` : ''}
            <div class="text-xs font-bold font-sans text-briella-charcoal mt-0.5">S/ ${(it.precio * it.qty).toFixed(2)}</div>
          </div>

          <div class="flex flex-col items-end gap-1.5">
            <button onclick="window.BriellaCartClient.removeItem(${idx})" class="w-5 h-5 rounded-full bg-briella-cream flex items-center justify-center text-xs text-briella-charcoal/60 hover:text-red-600 hover:bg-red-50 transition-colors" aria-label="Eliminar item">
              &times;
            </button>
            <div class="flex items-center border border-briella-cream-dark bg-white rounded-lg overflow-hidden p-0.5">
              <button onclick="window.BriellaCartClient.updateQty(${idx}, ${it.qty - 1})" class="w-5 h-5 flex items-center justify-center font-bold text-[10px] rounded hover:bg-briella-cream">-</button>
              <span class="w-5 text-center text-[11px] font-bold font-sans">${it.qty}</span>
              <button onclick="window.BriellaCartClient.updateQty(${idx}, ${it.qty + 1})" class="w-5 h-5 flex items-center justify-center font-bold text-[10px] rounded hover:bg-briella-cream">+</button>
            </div>
          </div>
        </div>
      `).join('');
    },

    sendOrder() {
      const nameInput = document.getElementById('cartInputCustomerName');
      const dniInput = document.getElementById('cartInputCustomerDni');
      const cityInput = document.getElementById('cartInputCustomerCity');
      const addressInput = document.getElementById('cartInputCustomerAddress');
      const notesInput = document.getElementById('cartInputCustomerNotes');
      const errEl = document.getElementById('cartFormError');

      const name = nameInput ? nameInput.value.trim() : '';
      const dni = dniInput ? dniInput.value.trim() : '';
      const city = cityInput ? cityInput.value.trim() : '';
      const address = addressInput ? addressInput.value.trim() : '';
      const extraNotes = notesInput ? notesInput.value.trim() : '';

      if (!name || !dni || !address) {
        if (errEl) errEl.classList.remove('hidden');
        return;
      }

      if (errEl) errEl.classList.add('hidden');

      const subtotal = this.items.reduce((s, it) => s + (it.precio * it.qty), 0).toFixed(2);

      let msg = `*NUEVO PEDIDO - JOYERÍA BRIELLA*\n`;
      msg += `------------------------------------\n`;
      msg += `*PRODUCTOS SOLICITADOS:*\n`;

      this.items.forEach(it => {
        msg += `• ${it.qty}x *${it.nombre}* (${it.material}) - S/ ${(it.precio * it.qty).toFixed(2)}\n`;
        if (it.customNote) msg += `  └ _Grabado: "${it.customNote}"_\n`;
      });

      msg += `------------------------------------\n`;
      msg += `*TOTAL ESTIMADO:* S/ ${subtotal}\n`;
      msg += `------------------------------------\n`;
      msg += `*DATOS DE ENVÍO Y CLIENTE:*\n`;
      msg += `• *Cliente:* ${name}\n`;
      msg += `• *DNI/Doc:* ${dni}\n`;
      msg += `• *Ciudad/Distrito:* ${city || 'Por coordinar'}\n`;
      msg += `• *Dirección:* ${address}\n`;
      if (extraNotes) {
        msg += `• *Nota/Dedicatoria:* ${extraNotes}\n`;
      }
      msg += `• *Medio de Pago:* Yape / Plin / Transferencia\n\n`;
      msg += `¡Hola Joyería Briella! Acabo de ingresar mis datos para este pedido. ¿Me confirman el pago y fecha de entrega?`;

      const waUrl = `https://wa.me/${this.waNumber}?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
      this.close();
    },

    showToast(message) {
      let toast = document.getElementById('briellaToastBox');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'briellaToastBox';
        toast.className = 'fixed bottom-16 sm:bottom-6 left-1/2 -translate-x-1/2 sm:left-6 sm:translate-x-0 z-50 bg-briella-charcoal text-white text-xs py-2.5 px-4 rounded-full shadow-floating flex items-center gap-2 toast-slide-up border border-white/10';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `
        <svg class="w-4 h-4 text-briella-whatsapp stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="font-medium">${message}</span>
      `;
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 2500);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    window.BriellaCartClient.init();
  });
</script>
