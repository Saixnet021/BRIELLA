---
// src/components/CustomSection.astro
---

<section
  id="personalizados"
  class="py-14 md:py-24 bg-white border-b border-briella-cream-dark"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
      <span
        class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-briella-blue block mb-2"
      >
        Taller SM Joyería
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-briella-charcoal mb-3"
      >
        Joyas Personalizadas a Medida
      </h2>
      <div class="w-12 h-0.5 bg-briella-blue/40 rounded-full mx-auto mb-3">
      </div>
      <p
        class="text-xs sm:text-sm text-briella-charcoal/70 leading-relaxed px-4"
      >
        Creamos piezas únicas en Plata Ley 950 y Oro 18k. Desde collares con nombres calados hasta anillos grabados y
        siluetas conmemorativas.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-12">
      <!-- Card 1: Nombres Calados -->
      <div
        class="bg-briella-cream-light rounded-2xl border border-briella-cream-dark p-3.5 sm:p-4 group hover:border-briella-blue/40 shadow-xs hover:shadow-card transition-all flex flex-col justify-between"
        data-aos="fade-up"
        data-aos-delay="50"
      >
        <div class="aspect-square bg-white rounded-xl overflow-hidden mb-4">
          <img
            src="assets/images/personalizado-01.jpg"
            alt="Collar con nombre calado Neyh en Plata 950"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="400"
            height="400"
          />
        </div>
        <div class="p-2 sm:p-3">
          <span
            class="text-[10px] font-bold uppercase tracking-widest text-briella-blue px-2.5 py-0.5 rounded-lg bg-briella-blue-light inline-block mb-2"
          >
            Diseño Clásico
          </span>
          <h3 class="font-serif text-xl font-medium text-briella-charcoal mb-2">
            Nombres Calados
          </h3>
          <p class="text-xs text-briella-charcoal/70 leading-relaxed">
            Elaborados con tipografía cursiva fluida o imprenta en Plata 950 y
            Oro 18k. Incluye cadena fina y acabado espejo diamantado.
          </p>
        </div>
      </div>

      <!-- Card 2: Siluetas de Mascotas -->
      <div
        class="bg-briella-cream-light rounded-2xl border border-briella-cream-dark p-3.5 sm:p-4 group hover:border-briella-blue/40 shadow-xs hover:shadow-card transition-all flex flex-col justify-between"
        data-aos="fade-up"
        data-aos-delay="150"
      >
        <div class="aspect-square bg-white rounded-xl overflow-hidden mb-4">
          <img
            src="assets/images/anillo-01.jpg"
            alt="Anillo con silueta de mascota grabada"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="400"
            height="400"
          />
        </div>
        <div class="p-2 sm:p-3">
          <span
            class="text-[10px] font-bold uppercase tracking-widest text-briella-lavender-dark px-2.5 py-0.5 rounded-lg bg-briella-lavender inline-block mb-2"
          >
            Amor Incondicional
          </span>
          <h3 class="font-serif text-xl font-medium text-briella-charcoal mb-2">
            Siluetas &amp; Huellitas
          </h3>
          <p class="text-xs text-briella-charcoal/70 leading-relaxed">
            Dijes y anillos personalizados con la silueta de tu perrito o gatito
            y su nombre grabado en alta precisión.
          </p>
        </div>
      </div>

      <!-- Card 3: Placas, Fechas e Iniciales -->
      <div
        class="bg-briella-cream-light rounded-2xl border border-briella-cream-dark p-3.5 sm:p-4 group hover:border-briella-blue/40 shadow-xs hover:shadow-card transition-all flex flex-col justify-between"
        data-aos="fade-up"
        data-aos-delay="250"
      >
        <div class="aspect-square bg-white rounded-xl overflow-hidden mb-4">
          <img
            src="assets/images/collar-02.jpg"
            alt="Dije candado grabado con iniciales y fechas"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="400"
            height="400"
          />
        </div>
        <div class="p-2 sm:p-3">
          <span
            class="text-[10px] font-bold uppercase tracking-widest text-briella-gold-dark px-2.5 py-0.5 rounded-lg bg-briella-gold-light inline-block mb-2"
          >
            Fechas &amp; Letras
          </span>
          <h3 class="font-serif text-xl font-medium text-briella-charcoal mb-2">
            Placas &amp; Candados
          </h3>
          <p class="text-xs text-briella-charcoal/70 leading-relaxed">
            Grabados con fechas inolvidables, coordenadas, números romanos o
            iniciales entrelazadas de tus seres queridos.
          </p>
        </div>
      </div>
    </div>

    <!-- How to Order Custom Jewelry -->
    <div
      class="bg-briella-cream rounded-2xl border border-briella-cream-dark p-6 sm:p-10 md:p-12 mb-8 shadow-xs"
    >
      <h3
        class="font-serif text-2xl sm:text-3xl font-medium text-briella-charcoal text-center mb-8"
      >
        ¿Cómo ordenar tu joya personalizada?
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <div
          class="flex items-start gap-4 p-4 rounded-xl bg-white border border-briella-cream-dark"
        >
          <span
            class="w-7 h-7 rounded-lg bg-briella-blue text-white text-xs font-bold flex items-center justify-center flex-shrink-0"
            >1</span
          >
          <div>
            <h4
              class="text-xs font-bold uppercase tracking-wider text-briella-charcoal mb-1"
            >
              Elige el Modelo
            </h4>
            <p class="text-xs text-briella-charcoal/70 leading-relaxed">
              Selecciona si deseas un collar, dije, pulsera o anillo en Plata
              950 u Oro 18k.
            </p>
          </div>
        </div>

        <div
          class="flex items-start gap-4 p-4 rounded-xl bg-white border border-briella-cream-dark"
        >
          <span
            class="w-7 h-7 rounded-lg bg-briella-blue text-white text-xs font-bold flex items-center justify-center flex-shrink-0"
            >2</span
          >
          <div>
            <h4
              class="text-xs font-bold uppercase tracking-wider text-briella-charcoal mb-1"
            >
              Envíanos tu Idea
            </h4>
            <p class="text-xs text-briella-charcoal/70 leading-relaxed">
              Escríbenos por WhatsApp el nombre, inicial o diseño deseado para
              coordinar detalles.
            </p>
          </div>
        </div>

        <div
          class="flex items-start gap-4 p-4 rounded-xl bg-white border border-briella-cream-dark"
        >
          <span
            class="w-7 h-7 rounded-lg bg-briella-blue text-white text-xs font-bold flex items-center justify-center flex-shrink-0"
            >3</span
          >
          <div>
            <h4
              class="text-xs font-bold uppercase tracking-wider text-briella-charcoal mb-1"
            >
              Confección &amp; Envío
            </h4>
            <p class="text-xs text-briella-charcoal/70 leading-relaxed">
              Elaboramos tu pieza en 48 a 72 horas y la enviamos en estuche de
              regalo a tu domicilio.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="text-center mt-8 sm:mt-10">
        <a
          href="https://wa.me/51984018633?text=¡Hola%20SM%20Joyería!%20Deseo%20cotizar%20una%20joya%20personalizada.%20¿Me%20brindan%20información%20y%20precios?"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-briella-whatsapp hover:bg-briella-whatsapp-dark active:scale-95 text-white px-8 py-3 rounded-xl text-xs font-bold uppercase tracking-widest transition-all shadow-wa"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7.0 8.98 7.0 10.21C7.0 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"
            ></path>
          </svg>
          <span>Cotizar Joya Personalizada</span>
        </a>
      </div>
    </div>
  </div>
</section>
