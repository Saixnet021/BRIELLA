            >
              <svg
                class="w-4 h-4 text-briella-purple stroke-[2]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>ADJUNTAR VOUCHER</span>
            </div>
            <div
              id="modalVoucherAttachedState"
              class="hidden items-center gap-2 text-xs font-bold text-emerald-600"
            >
              <svg
                class="w-4 h-4 stroke-[2.5]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span id="modalVoucherFileName"
                >Voucher adjunto correctamente</span
              >
            </div>
          </label>
        </div>

        <p
          id="modalStep2Error"
          class="hidden text-[11px] text-red-600 font-bold bg-red-50 p-2.5 rounded-lg border border-red-200"
        >
          Por favor ingresa el número de operación o adjunta tu comprobante para
          confirmar el pedido.
        </p>

        <!-- Actions Step 2 -->
        <div
          class="grid grid-cols-2 gap-3 pt-3 border-t border-briella-cream-dark"
        >
          <button
            id="btnModalBackToStep1"
            type="button"
            class="py-2.5 px-4 rounded-xl bg-briella-cream hover:bg-briella-cream-dark text-briella-charcoal text-xs font-bold uppercase tracking-wider text-center transition-colors active:scale-95"
          >
            ATRÁS
          </button>

          <button
            id="btnModalConfirmPayment"
            type="button"
            class="py-2.5 px-4 rounded-xl bg-briella-purple hover:bg-briella-purple-dark text-white text-xs font-bold uppercase tracking-wider text-center shadow-md transition-all active:scale-[0.98]"
          >
            CONFIRMAR PEDIDO
          </button>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- PASO 3: CONFIRMACIÓN DE ÉXITO                  -->
      <!-- ============================================== -->
      <div
        id="modalStep3Content"
        class="hidden flex-col items-center text-center py-6 sm:py-8 space-y-4"
      >
        <!-- Big Checkmark Circle -->
        <div
          class="w-14 h-14 rounded-full bg-briella-purple text-white flex items-center justify-center shadow-md animate-bounce"
        >
          <svg
            class="w-7 h-7 stroke-[3]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>

        <!-- Success Title -->
        <div class="space-y-1">
          <h3
            class="font-serif text-2xl sm:text-3xl font-bold text-briella-charcoal"
          >
            ¡Pedido Recibido con Éxito!
          </h3>
          <p
            class="text-xs sm:text-sm text-briella-charcoal/70 max-w-md mx-auto leading-relaxed"
          >
            Gracias por tu compra en <strong class="text-briella-charcoal"
              >SM JOYERÍA</strong
            >. Hemos registrado tu pedido y prepararemos el despacho a tu
            domicilio.
          </p>
        </div>

        <!-- Order Code Box -->
        <div
          class="w-full max-w-sm bg-briella-cream rounded-xl border border-briella-cream-dark p-3.5 shadow-xs"
        >
          <span
            class="text-[10px] font-bold uppercase tracking-widest text-briella-charcoal/60 block mb-0.5"
          >
            CÓDIGO DE PEDIDO
          </span>
          <span
            id="modalGeneratedOrderCode"
            class="text-xl sm:text-2xl font-extrabold font-mono text-briella-purple tracking-widest"
          >
            SM-VOWLREEA
          </span>
        </div>

        <!-- Action Buttons -->
        <div class="w-full max-w-sm space-y-2.5 pt-2">
          <!-- WhatsApp Send Confirmation Button -->
          <a
            id="btnModalSendWhatsAppConfirmation"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-[#25D366] hover:bg-[#1EBE5D] text-white py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider transition-all shadow-wa flex items-center justify-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7.0 8.98 7.0 10.21C7.0 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"
              ></path>
            </svg>
            <span>ENVIAR CONFIRMACIÓN A WHATSAPP</span>
          </a>

          <!-- Return to Store -->
          <button
            id="btnModalFinishClose"
            type="button"
            class="w-full bg-white hover:bg-briella-cream border border-briella-cream-dark py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider text-briella-charcoal transition-colors active:scale-95"
          >
            VOLVER A LA TIENDA
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    let currentMode = "single"; // 'single' or 'cart'
    let currentSingleProduct = null;
    let currentSingleQty = 1;
    let currentStep = 1;
    let generatedOrderCode = "";
    const waNumber = "51984018633";

    // Global Cart State
    let cartItems = [];

    function loadCart() {
      try {
        const saved =
          localStorage.getItem("sm_joyeria_cart_v1") ||
          localStorage.getItem("briella_cart_astro_v1");
        if (saved) cartItems = JSON.parse(saved);
      } catch (e) {
        cartItems = [];
      }
      updateCartHeaderBadges();
    }

    function saveCart() {
      try {
        localStorage.setItem("sm_joyeria_cart_v1", JSON.stringify(cartItems));
      } catch (e) {}
      updateCartHeaderBadges();
    }

    function updateCartHeaderBadges() {
      const totalCount = cartItems.reduce((s, it) => s + it.qty, 0);
      const subtotal = cartItems.reduce((s, it) => s + it.precio * it.qty, 0);

      const headerCount = document.getElementById("cartBadgeCount");
      const mobileBarCount = document.getElementById("mobileBarCartBadge");
      const headerTotal = document.getElementById("headerCartTotalText");

      if (headerCount) headerCount.textContent = totalCount;
      if (mobileBarCount) mobileBarCount.textContent = totalCount;
      if (headerTotal) headerTotal.textContent = `S/ ${subtotal.toFixed(2)}`;
    }

    // Modal elements
    const modal = document.getElementById("productDetailModal");
    const mainTitle = document.getElementById("checkoutModalMainTitle");
    const btnClose = document.getElementById("btnModalClose");
    const stepperBar = document.getElementById("modalStepperBar");

    // Single item elements
    const singleProductBox = document.getElementById("modalSingleProductBox");
    const imgEl = document.getElementById("modalProductImg");
    const badgeEl = document.getElementById("modalProductBadge");
    const titleEl = document.getElementById("modalProductTitle");
    const unitPriceEl = document.getElementById("modalProductUnitPrice");
    const customBox = document.getElementById("modalCustomNoteBox");
    const customInput = document.getElementById("modalCustomInput");
    const qtyDisplay = document.getElementById("modalQtyDisplay");
    const qtyMinus = document.getElementById("modalQtyMinus");
    const qtyPlus = document.getElementById("modalQtyPlus");
    const btnAddToCart = document.getElementById("btnModalAddToCart");

    // Cart mode elements
    const emptyCartNotice = document.getElementById("modalEmptyCartNotice");
    const cartItemsList = document.getElementById("modalCartItemsList");
    const step1FormFields = document.getElementById("modalStep1FormFields");
    const step1Actions = document.getElementById("modalStep1Actions");
    const step1TotalBar = document.getElementById("modalStep1TotalBar");
    const step1TotalEl = document.getElementById("modalStep1Total");
    const btnExploreCatalog = document.getElementById("btnModalExploreCatalog");

    // Stepper elements
    const stepperCircle1 = document.getElementById("stepperCircle1");
    const stepperCheck1 = document.getElementById("stepperCheck1");
    const stepperNum1 = document.getElementById("stepperNum1");
    const stepperLine1 = document.getElementById("stepperLine1");

    const stepperCircle2 = document.getElementById("stepperCircle2");
    const stepperCheck2 = document.getElementById("stepperCheck2");
    const stepperCard2 = document.getElementById("stepperCard2");
    const stepperLine2 = document.getElementById("stepperLine2");

    const stepperCircle3 = document.getElementById("stepperCircle3");
    const stepperText1 = document.getElementById("stepperText1");
    const stepperText2 = document.getElementById("stepperText2");
    const stepperText3 = document.getElementById("stepperText3");

    // Step contents
    const step1Content = document.getElementById("modalStep1Content");
    const step2Content = document.getElementById("modalStep2Content");
    const step3Content = document.getElementById("modalStep3Content");

    // Step 1 Form
    const inputName = document.getElementById("modalInputName");
    const inputDni = document.getElementById("modalInputDni");
    const inputPhone = document.getElementById("modalInputPhone");
    const inputCity = document.getElementById("modalInputCity");
    const inputAddress = document.getElementById("modalInputAddress");
    const step1Error = document.getElementById("modalStep1Error");
    const btnGoToStep2 = document.getElementById("btnModalGoToStep2");

    // Step 2 elements
    const step2ItemsList = document.getElementById("modalStep2ItemsList");
    const step2GrandTotal = document.getElementById("modalStep2GrandTotal");
    const btnAutoFill = document.getElementById("btnModalAutoFillVoucher");
    const btnCopyNumber = document.getElementById("btnModalCopyNumber");
    const copyBtnText = document.getElementById("copyBtnText");
    const inputOpNumber = document.getElementById("modalInputOpNumber");
    const voucherFileInput = document.getElementById("modalVoucherFileInput");
    const voucherEmptyState = document.getElementById("modalVoucherEmptyState");
    const voucherAttachedState = document.getElementById(
      "modalVoucherAttachedState",
    );
    const voucherFileName = document.getElementById("modalVoucherFileName");
    const step2Error = document.getElementById("modalStep2Error");
    const btnBackToStep1 = document.getElementById("btnModalBackToStep1");
    const btnConfirmPayment = document.getElementById("btnModalConfirmPayment");

    // Step 3 elements
    const orderCodeDisplay = document.getElementById("modalGeneratedOrderCode");
    const btnSendWhatsApp = document.getElementById(
      "btnModalSendWhatsAppConfirmation",
    );
    const btnFinishClose = document.getElementById("btnModalFinishClose");

    function generateCode() {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      let res = "SM-";
      for (let i = 0; i < 7; i++) {
        res += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return res;
    }

    function calculateTotal() {
      if (currentMode === "single") {
        return currentSingleProduct
          ? (currentSingleProduct.precio * currentSingleQty).toFixed(2)
          : "0.00";
      } else {
        return cartItems
          .reduce((s, it) => s + it.precio * it.qty, 0)
          .toFixed(2);
      }
    }

    function renderCartItems() {
      if (!cartItemsList) return;

      if (cartItems.length === 0) {
        if (emptyCartNotice) emptyCartNotice.classList.remove("hidden");
        if (cartItemsList) cartItemsList.classList.add("hidden");
        if (step1TotalBar) step1TotalBar.classList.add("hidden");
        if (step1FormFields) step1FormFields.classList.add("hidden");
        if (step1Actions) step1Actions.classList.add("hidden");
        return;
      }

      if (emptyCartNotice) emptyCartNotice.classList.add("hidden");
      if (cartItemsList) cartItemsList.classList.remove("hidden");
      if (step1TotalBar) step1TotalBar.classList.remove("hidden");
      if (step1FormFields) step1FormFields.classList.remove("hidden");
      if (step1Actions) step1Actions.classList.remove("hidden");

      cartItemsList.innerHTML = cartItems
        .map(
          (it, idx) => `
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-[#FAF9F6] border border-briella-cream-dark">
          <img src="${it.imagen}" alt="${it.nombre}" class="w-12 h-12 object-cover rounded-lg border border-briella-cream-dark bg-white flex-shrink-0" />
          
          <div class="flex-1 min-w-0">
            <h4 class="font-serif text-xs font-bold text-briella-charcoal truncate">${it.nombre}</h4>
            <span class="text-[9px] text-briella-purple font-bold uppercase tracking-wider block">${it.material}</span>
            ${it.customNote ? `<span class="text-[9px] bg-briella-lavender text-briella-lavender-dark px-1.5 py-0.5 rounded inline-block font-medium">"${it.customNote}"</span>` : ""}
            <div class="text-xs font-bold font-sans text-briella-charcoal mt-0.5">S/ ${(it.precio * it.qty).toFixed(2)}</div>
          </div>

          <div class="flex flex-col items-end gap-1.5">
            <button type="button" class="btn-remove-cart-item text-briella-charcoal/50 hover:text-red-600 text-sm font-bold w-5 h-5 flex items-center justify-center rounded hover:bg-red-50" data-index="${idx}">&times;</button>
            <div class="flex items-center border border-briella-cream-dark bg-white rounded-lg overflow-hidden p-0.5">
              <button type="button" class="btn-cart-minus w-5 h-5 flex items-center justify-center font-bold text-[10px] rounded hover:bg-briella-cream" data-index="${idx}">-</button>
              <span class="w-5 text-center text-[10px] font-bold font-sans">${it.qty}</span>
              <button type="button" class="btn-cart-plus w-5 h-5 flex items-center justify-center font-bold text-[10px] rounded hover:bg-briella-cream" data-index="${idx}">+</button>
            </div>
          </div>
        </div>
      `,
        )
        .join("");

      // Bind dynamic remove/qty
      cartItemsList.querySelectorAll(".btn-remove-cart-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.index, 10);
          cartItems.splice(idx, 1);
          saveCart();
          renderCartItems();
          updateTotalDisplays();
        });
      });

      cartItemsList.querySelectorAll(".btn-cart-minus").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.index, 10);
          if (cartItems[idx]) {
            if (cartItems[idx].qty > 1) {
              cartItems[idx].qty--;
            } else {
              cartItems.splice(idx, 1);
            }
            saveCart();
            renderCartItems();
            updateTotalDisplays();
          }
        });
      });

      cartItemsList.querySelectorAll(".btn-cart-plus").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.index, 10);
          if (cartItems[idx]) {
            cartItems[idx].qty++;
            saveCart();
            renderCartItems();
            updateTotalDisplays();
          }
        });
      });
    }

    function updateTotalDisplays() {
      const tot = calculateTotal();
      if (step1TotalEl) step1TotalEl.textContent = tot;
      if (step2GrandTotal) step2GrandTotal.textContent = tot;
      if (currentSingleProduct && unitPriceEl) {
        unitPriceEl.textContent = currentSingleProduct.precio.toFixed(2);
      }
    }

    function setStep(step) {
      currentStep = step;
      if (step1Error) step1Error.classList.add("hidden");
      if (step2Error) step2Error.classList.add("hidden");

      if (step === 1) {
        if (step1Content) step1Content.classList.remove("hidden");
        if (step2Content) step2Content.classList.add("hidden");
        if (step3Content) step3Content.classList.add("hidden");

        // Stepper 1 Active
        stepperCircle1.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold transition-all shadow-xs";
        stepperCheck1.classList.add("hidden");
        stepperNum1.classList.remove("hidden");
        stepperLine1.style.width = "0%";
        stepperText1.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal";

        // Stepper 2 Inactive
        stepperCircle2.className =
          "w-7 h-7 rounded-full bg-briella-cream-dark text-briella-charcoal/60 flex items-center justify-center text-xs font-bold transition-all";
        stepperCheck2.classList.add("hidden");
        stepperCard2.classList.remove("hidden");
        stepperLine2.style.width = "0%";
        stepperText2.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/50";

        // Stepper 3 Inactive
        stepperCircle3.className =
          "w-7 h-7 rounded-full bg-briella-cream-dark text-briella-charcoal/60 flex items-center justify-center text-xs font-bold transition-all";
        stepperText3.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/50";

        updateTotalDisplays();
      } else if (step === 2) {
        if (step1Content) step1Content.classList.add("hidden");
        if (step2Content) step2Content.classList.remove("hidden");
        if (step3Content) step3Content.classList.add("hidden");

        // Stepper 1 Done
        stepperCircle1.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold transition-all shadow-xs";
        stepperNum1.classList.add("hidden");
        stepperCheck1.classList.remove("hidden");
        stepperLine1.style.width = "100%";
        stepperText1.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal";

        // Stepper 2 Active
        stepperCircle2.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold transition-all shadow-xs";
        stepperCheck2.classList.add("hidden");
        stepperCard2.classList.remove("hidden");
        stepperLine2.style.width = "0%";
        stepperText2.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal";

        // Stepper 3 Inactive
        stepperCircle3.className =
          "w-7 h-7 rounded-full bg-briella-cream-dark text-briella-charcoal/60 flex items-center justify-center text-xs font-bold transition-all";
        stepperText3.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/50";

        // Render Step 2 items breakdown
        if (step2ItemsList) {
          if (currentMode === "single" && currentSingleProduct) {
            step2ItemsList.innerHTML = `
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <img src="${currentSingleProduct.imagen}" alt="${currentSingleProduct.nombre}" class="w-10 h-10 rounded-lg object-cover bg-briella-cream border border-briella-cream-dark" />
                  <div>
                    <h4 class="font-serif text-xs font-bold text-briella-charcoal truncate max-w-[200px]">${currentSingleProduct.nombre}</h4>
                    <span class="text-[10px] text-briella-charcoal/60">${currentSingleQty} x S/ ${currentSingleProduct.precio.toFixed(2)}</span>
                  </div>
                </div>
                <span class="text-xs font-bold font-sans text-briella-charcoal">S/ ${(currentSingleProduct.precio * currentSingleQty).toFixed(2)}</span>
              </div>
            `;
          } else {
            step2ItemsList.innerHTML = cartItems
              .map(
                (it) => `
              <div class="flex items-center justify-between py-1 border-b border-neutral-100 last:border-0">
                <div class="flex items-center gap-2">
                  <img src="${it.imagen}" alt="${it.nombre}" class="w-8 h-8 rounded-md object-cover bg-briella-cream border border-briella-cream-dark" />
                  <div>
                    <h4 class="font-serif text-[11px] font-bold text-briella-charcoal truncate max-w-[170px]">${it.nombre}</h4>
                    <span class="text-[9px] text-briella-charcoal/60">${it.qty} x S/ ${it.precio.toFixed(2)}</span>
                  </div>
                </div>
                <span class="text-xs font-bold font-sans text-briella-charcoal">S/ ${(it.precio * it.qty).toFixed(2)}</span>
              </div>
            `,
              )
              .join("");
          }
        }

        updateTotalDisplays();
      } else if (step === 3) {
        if (step1Content) step1Content.classList.add("hidden");
        if (step2Content) step2Content.classList.add("hidden");
        if (step3Content) {
          step3Content.classList.remove("hidden");
          step3Content.classList.add("flex");
        }

        // Steppers all Done
        stepperCircle1.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold";
        stepperNum1.classList.add("hidden");
        stepperCheck1.classList.remove("hidden");
        stepperLine1.style.width = "100%";

        stepperCircle2.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold";
        stepperCard2.classList.add("hidden");
        stepperCheck2.classList.remove("hidden");
        stepperLine2.style.width = "100%";

        stepperCircle3.className =
          "w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold";
        stepperText3.className =
          "text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal";

        generatedOrderCode = generateCode();
        if (orderCodeDisplay) orderCodeDisplay.textContent = generatedOrderCode;

        buildWhatsAppMessage();

        // Clear cart if completed in cart mode
        if (currentMode === "cart") {
          cartItems = [];
          saveCart();
        }
      }
    }

    window.openProductModal = function (product) {
      currentMode = "single";
      currentSingleProduct = product;
      currentSingleQty = 1;

      if (mainTitle) mainTitle.textContent = "FINALIZAR COMPRA — SM JOYERÍA";
      if (singleProductBox) singleProductBox.classList.remove("hidden");
      if (cartItemsList) cartItemsList.classList.add("hidden");
      if (emptyCartNotice) emptyCartNotice.classList.add("hidden");
      if (btnAddToCart) btnAddToCart.classList.remove("hidden");
      if (step1TotalBar) step1TotalBar.classList.remove("hidden");
      if (step1FormFields) step1FormFields.classList.remove("hidden");
      if (step1Actions) step1Actions.classList.remove("hidden");

      if (qtyDisplay) qtyDisplay.textContent = "1";
      if (imgEl) {
        imgEl.src = product.imagen;
        imgEl.alt = product.nombre;
      }
      if (badgeEl) badgeEl.textContent = product.material.toUpperCase();
      if (titleEl) titleEl.textContent = product.nombre;

      if (customBox) {
        if (product.es_personalizable) {
          customBox.classList.remove("hidden");
        } else {
          customBox.classList.add("hidden");
        }
      }

      setStep(1);
      openModalView();
    };

    window.openCartCheckoutModal = function () {
      currentMode = "cart";
      currentSingleProduct = null;

      if (mainTitle) mainTitle.textContent = "MI BOLSA DE COMPRAS — SM JOYERÍA";
      if (singleProductBox) singleProductBox.classList.add("hidden");
      if (btnAddToCart) btnAddToCart.classList.add("hidden");
      if (customBox) customBox.classList.add("hidden");

      renderCartItems();
      setStep(1);
      openModalView();
    };

    function openModalView() {
      if (inputOpNumber) inputOpNumber.value = "";
      if (voucherEmptyState) voucherEmptyState.classList.remove("hidden");
      if (voucherAttachedState) voucherAttachedState.classList.add("hidden");

      if (modal) {
        modal.classList.remove("opacity-0", "pointer-events-none");
        modal.classList.add("opacity-100", "pointer-events-auto");
        document.body.style.overflow = "hidden";
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add("opacity-0", "pointer-events-none");
        modal.classList.remove("opacity-100", "pointer-events-auto");
        document.body.style.overflow = "";
      }
    }

    if (btnClose) btnClose.addEventListener("click", closeModal);
    if (btnFinishClose) btnFinishClose.addEventListener("click", closeModal);
    if (btnExploreCatalog)
      btnExploreCatalog.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Quantity for Single Product
    if (qtyMinus) {
      qtyMinus.addEventListener("click", () => {
        if (currentSingleQty > 1) {
          currentSingleQty--;
          qtyDisplay.textContent = currentSingleQty;
          updateTotalDisplays();
        }
      });
    }

    if (qtyPlus) {
      qtyPlus.addEventListener("click", () => {
        currentSingleQty++;
        qtyDisplay.textContent = currentSingleQty;
        updateTotalDisplays();
      });
    }

    // Add to Cart from Modal
    if (btnAddToCart) {
      btnAddToCart.addEventListener("click", () => {
        if (!currentSingleProduct) return;
        const customNote = customInput ? customInput.value.trim() : "";

        const idx = cartItems.findIndex(
          (it) =>
            it.id === currentSingleProduct.id && it.customNote === customNote,
        );

        if (idx > -1) {
          cartItems[idx].qty += currentSingleQty;
        } else {
          cartItems.push({
            id: currentSingleProduct.id,
            nombre: currentSingleProduct.nombre,
            material: currentSingleProduct.material,
            precio: currentSingleProduct.precio,
            imagen: currentSingleProduct.imagen,
            qty: currentSingleQty,
            customNote,
          });
        }

        saveCart();
        closeModal();
      });
    }

    // Step 1 -> Step 2 Validation
    if (btnGoToStep2) {
      btnGoToStep2.addEventListener("click", () => {
        const name = inputName ? inputName.value.trim() : "";
        const dni = inputDni ? inputDni.value.trim() : "";
        const phone = inputPhone ? inputPhone.value.trim() : "";
        const city = inputCity ? inputCity.value.trim() : "";
        const address = inputAddress ? inputAddress.value.trim() : "";

        if (!name || !dni || !phone || !address) {
          if (step1Error) step1Error.classList.remove("hidden");
          return;
        }

        if (step1Error) step1Error.classList.add("hidden");
        setStep(2);
      });
    }

    // Step 2 -> Back to Step 1
    if (btnBackToStep1) {
      btnBackToStep1.addEventListener("click", () => setStep(1));
    }

    // Copy Yape/Plin number
    if (btnCopyNumber) {
      btnCopyNumber.addEventListener("click", () => {
        navigator.clipboard
          .writeText("984018633")
          .then(() => {
            if (copyBtnText) copyBtnText.textContent = "¡COPIADO!";
            setTimeout(() => {
              if (copyBtnText) copyBtnText.textContent = "COPIAR";
            }, 2000);
          })
          .catch(() => {
            if (copyBtnText) copyBtnText.textContent = "984018633";
          });
      });
    }

    // Demo Autocomplete Voucher
    if (btnAutoFill) {
      btnAutoFill.addEventListener("click", () => {
        const randomOp = "DEMO-" + Math.floor(100000 + Math.random() * 900000);
        if (inputOpNumber) inputOpNumber.value = randomOp;
        if (voucherEmptyState) voucherEmptyState.classList.add("hidden");
        if (voucherAttachedState) {
          voucherAttachedState.classList.remove("hidden");
          voucherAttachedState.classList.add("flex");
        }
        if (voucherFileName)
          voucherFileName.textContent = `Voucher Simulado (${randomOp}.png)`;
      });
    }

    // Voucher File Upload
    if (voucherFileInput) {
      voucherFileInput.addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (file) {
          if (voucherEmptyState) voucherEmptyState.classList.add("hidden");
          if (voucherAttachedState) {
            voucherAttachedState.classList.remove("hidden");
            voucherAttachedState.classList.add("flex");
          }
          if (voucherFileName) voucherFileName.textContent = file.name;
        }
      });
    }

    // Step 2 -> Step 3 Validation & Finish
    if (btnConfirmPayment) {
      btnConfirmPayment.addEventListener("click", () => {
        const opNum = inputOpNumber ? inputOpNumber.value.trim() : "";
        const hasVoucherFile =
          voucherFileInput && voucherFileInput.files.length > 0;
        const isDemoBypass =
          voucherFileName && voucherFileName.textContent.includes("Simulado");

        if (!opNum && !hasVoucherFile && !isDemoBypass) {
          if (step2Error) step2Error.classList.remove("hidden");
          return;
        }

        if (step2Error) step2Error.classList.add("hidden");
        setStep(3);
      });
    }

    // Build WhatsApp message
    function buildWhatsAppMessage() {
      const name = inputName ? inputName.value.trim() : "";
      const dni = inputDni ? inputDni.value.trim() : "";
      const phone = inputPhone ? inputPhone.value.trim() : "";
      const city = inputCity ? inputCity.value.trim() : "";
      const address = inputAddress ? inputAddress.value.trim() : "";
      const customNote = customInput ? customInput.value.trim() : "";
      const opNum = inputOpNumber
        ? inputOpNumber.value.trim()
        : "Por verificar";
      const totalAmount = calculateTotal();

      let msg = `*NUEVO PEDIDO CONFIRMADO — SM JOYERÍA*\n`;
      msg += `------------------------------------\n`;
      msg += `*CÓDIGO DE PEDIDO:* \`${generatedOrderCode}\`\n`;
      msg += `------------------------------------\n`;
      msg += `*PRODUCTOS:*\n`;

      if (currentMode === "single" && currentSingleProduct) {
        msg += `• ${currentSingleQty}x *${currentSingleProduct.nombre}* (${currentSingleProduct.material}) - S/ ${(currentSingleProduct.precio * currentSingleQty).toFixed(2)}\n`;
        if (customNote) msg += `  └ _Grabado: "${customNote}"_\n`;
      } else {
        cartItems.forEach((it) => {
          msg += `• ${it.qty}x *${it.nombre}* (${it.material}) - S/ ${(it.precio * it.qty).toFixed(2)}\n`;
          if (it.customNote) msg += `  └ _Grabado: "${it.customNote}"_\n`;
        });
      }

      msg += `------------------------------------\n`;
      msg += `*TOTAL PAGADO:* S/ ${totalAmount}\n`;
      msg += `------------------------------------\n`;
      msg += `*DATOS DE ENTREGA:*\n`;
      msg += `• *Cliente:* ${name}\n`;
      msg += `• *DNI/Doc:* ${dni}\n`;
      msg += `• *Teléfono:* ${phone}\n`;
      msg += `• *Ciudad/Distrito:* ${city || "Por coordinar"}\n`;
      msg += `• *Dirección:* ${address}\n`;
      msg += `------------------------------------\n`;
      msg += `*MÉTODO DE PAGO:*\n`;
      msg += `• *Medio:* Yape / Plin\n`;
      msg += `• *Nro. de Operación:* \`${opNum}\`\n\n`;
      msg += `¡Hola SM Joyería! Acabo de registrar mi compra en la web con el código *${generatedOrderCode}*. Adjunto mi comprobante para que puedan proceder con el despacho.`;

      const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      if (btnSendWhatsApp) {
        btnSendWhatsApp.href = waUrl;
      }
    }

    // Expose Global Cart API
    window.BriellaCartClient = {
      addItem(product, qty = 1, customNote = "") {
        const idx = cartItems.findIndex(
          (it) => it.id === product.id && it.customNote === customNote,
        );
        if (idx > -1) {
          cartItems[idx].qty += qty;
        } else {
          cartItems.push({
            id: product.id,
            nombre: product.nombre,
            material: product.material,
            precio: product.precio,
            imagen: product.imagen,
            qty,
            customNote,
          });
        }
        saveCart();
      },
      openCheckout() {
        window.openCartCheckoutModal();
      },
    };

    // Bind triggers from Header & Floating Bar Cart triggers
    const headerCartBtn = document.getElementById("btnCartTrigger");
    const mobileBarCartBtn = document.getElementById("btnMobileCartTrigger");

    if (headerCartBtn) {
      headerCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        window.openCartCheckoutModal();
      });
    }

    if (mobileBarCartBtn) {
      mobileBarCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        window.openCartCheckoutModal();
      });
    }

    // Bind product card buttons
    document.querySelectorAll(".product-open-modal").forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        const card = trigger.closest(".product-card");
        const jsonStr =
          card?.querySelector(".btn-buy-now")?.dataset.productJson;
        if (jsonStr) {
          const product = JSON.parse(jsonStr);
          window.openProductModal(product);
        }
      });
    });

    document.querySelectorAll(".btn-add-to-cart").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        e.preventDefault();
        const product = JSON.parse(btn.dataset.productJson || "{}");
        if (product.id) {
          window.BriellaCartClient.addItem(product, 1);
        }
      });
    });

    // Initialize cart from localStorage
    loadCart();
  });
</script>
