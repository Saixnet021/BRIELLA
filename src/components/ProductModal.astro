---
// src/components/ProductModal.astro
---

<div id="productDetailModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-briella-charcoal/65 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="relative w-full max-w-3xl bg-white border border-briella-cream-dark shadow-2xl max-h-[92vh] overflow-y-auto grid grid-cols-1 md:grid-cols-2">
    
    <!-- Close Button -->
    <button id="btnModalClose" class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full bg-white border border-briella-cream-dark flex items-center justify-center text-briella-charcoal hover:bg-briella-charcoal hover:text-white transition-colors" aria-label="Cerrar modal">
      <svg class="w-4 h-4 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Media -->
    <div class="bg-[#FAF8F5] flex flex-col items-center justify-center p-6 border-b md:border-b-0 md:border-r border-briella-cream-dark">
      <img id="modalProductImg" src="" alt="" class="w-full h-auto max-h-[320px] object-cover" />
      <span id="modalProductBadge" class="mt-3 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 border border-briella-cream-dark bg-white text-briella-blue"></span>
    </div>

    <!-- Modal Form & Purchase Area -->
    <div class="p-5 sm:p-7 flex flex-col justify-between space-y-4">
      <div>
        <span id="modalProductCategory" class="text-[10px] font-bold uppercase tracking-widest text-briella-blue block mb-1"></span>
        <h2 id="modalProductTitle" class="font-serif text-xl sm:text-2xl font-medium text-briella-charcoal mb-1.5 leading-snug"></h2>
        
        <!-- Price Row & Quantity -->
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-briella-cream-dark">
          <div class="flex items-baseline gap-1">
            <span class="text-xs font-bold text-briella-blue">S/</span>
            <span id="modalProductPrice" class="text-xl font-bold font-sans text-briella-charcoal"></span>
          </div>

          <div class="flex items-center border border-briella-cream-dark bg-white">
            <button id="modalQtyMinus" type="button" class="w-7 h-7 flex items-center justify-center font-bold text-xs hover:bg-briella-cream">-</button>
            <span id="modalQtyDisplay" class="w-7 text-center text-xs font-bold font-sans">1</span>
            <button id="modalQtyPlus" type="button" class="w-7 h-7 flex items-center justify-center font-bold text-xs hover:bg-briella-cream">+</button>
          </div>
        </div>

        <!-- Customer Data Form Required to Order -->
        <div class="space-y-2.5">
          <div class="text-[11px] font-bold uppercase tracking-wider text-briella-charcoal/80 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-briella-blue stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Datos para tu Pedido:</span>
          </div>

          <div class="space-y-2">
            <input 
              type="text" 
              id="modalInputName" 
              placeholder="Nombre y Apellidos *" 
              required
              class="w-full bg-briella-cream text-xs py-2 px-3 border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none"
            />
            
            <div class="grid grid-cols-2 gap-2">
              <input 
                type="text" 
                id="modalInputDni" 
                placeholder="DNI / Documento *" 
                maxlength="12"
                required
                class="w-full bg-briella-cream text-xs py-2 px-3 border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none"
              />
              <input 
                type="text" 
                id="modalInputCity" 
                placeholder="Ciudad / Distrito *" 
                required
                class="w-full bg-briella-cream text-xs py-2 px-3 border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none"
              />
            </div>

            <input 
              type="text" 
              id="modalInputAddress" 
              placeholder="Dirección de Entrega *" 
              required
              class="w-full bg-briella-cream text-xs py-2 px-3 border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none"
            />

            <!-- Optional Engraving Note -->
            <div id="modalCustomNoteBox" class="hidden pt-1">
              <input 
                type="text" 
                id="modalCustomInput" 
                placeholder="Nombre o Grabado deseado (Ej. 'Neyh', fecha)..." 
                class="w-full bg-briella-cream text-xs py-2 px-3 border border-briella-cream-dark focus:border-briella-blue focus:bg-white outline-none"
              />
            </div>
          </div>

          <p id="modalFormError" class="hidden text-[11px] text-red-600 font-medium">
            Por favor ingresa tu Nombre, DNI y Dirección para continuar.
          </p>
        </div>

      </div>

      <!-- Action Buttons -->
      <div class="space-y-2 pt-3 border-t border-briella-cream-dark">
        <!-- Main Direct Order WhatsApp Button -->
        <button 
          id="btnModalDirectWaSubmit" 
          type="button"
          class="w-full bg-briella-whatsapp hover:bg-briella-whatsapp-dark text-white py-3 px-4 text-xs font-bold uppercase tracking-widest transition-all shadow-wa flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7 8.98 7 10.21C7 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"/>
          </svg>
          <span>Confirmar y Comprar por WhatsApp</span>
        </button>

        <!-- Secondary Add to Cart Button -->
        <button 
          id="btnModalAddToCart" 
          type="button" 
          class="w-full bg-briella-cream hover:bg-briella-cream-dark text-briella-charcoal border border-briella-cream-dark py-2 px-4 text-xs font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-3.5 h-3.5 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Guardar en mi Bolsa de Compras</span>
        </button>
      </div>

    </div>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let currentProduct = null;
    let currentQty = 1;

    const modal = document.getElementById('productDetailModal');
    const btnClose = document.getElementById('btnModalClose');
    const imgEl = document.getElementById('modalProductImg');
    const badgeEl = document.getElementById('modalProductBadge');
    const categoryEl = document.getElementById('modalProductCategory');
    const titleEl = document.getElementById('modalProductTitle');
    const priceEl = document.getElementById('modalProductPrice');
    const customBox = document.getElementById('modalCustomNoteBox');
    const customInput = document.getElementById('modalCustomInput');
    const qtyDisplay = document.getElementById('modalQtyDisplay');
    const qtyMinus = document.getElementById('modalQtyMinus');
    const qtyPlus = document.getElementById('modalQtyPlus');
    const btnAdd = document.getElementById('btnModalAddToCart');
    const btnWaSubmit = document.getElementById('btnModalDirectWaSubmit');

    const inputName = document.getElementById('modalInputName');
    const inputDni = document.getElementById('modalInputDni');
    const inputCity = document.getElementById('modalInputCity');
    const inputAddress = document.getElementById('modalInputAddress');
    const formError = document.getElementById('modalFormError');

    window.openProductModal = function(product) {
      currentProduct = product;
      currentQty = 1;
      if (qtyDisplay) qtyDisplay.textContent = '1';
      if (formError) formError.classList.add('hidden');

      if (imgEl) {
        imgEl.src = product.imagen;
        imgEl.alt = product.nombre;
      }
      if (badgeEl) {
        badgeEl.textContent = product.material.toUpperCase();
      }
      if (categoryEl) categoryEl.textContent = product.categoria;
      if (titleEl) titleEl.textContent = product.nombre;
      if (priceEl) priceEl.textContent = (product.precio * currentQty).toFixed(2);

      if (customBox) {
        if (product.es_personalizable) {
          customBox.classList.remove('hidden');
        } else {
          customBox.classList.add('hidden');
        }
      }

      if (modal) {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      }
    };

    function updateModalPrice() {
      if (currentProduct && priceEl) {
        priceEl.textContent = (currentProduct.precio * currentQty).toFixed(2);
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
      }
    }

    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    if (qtyMinus) {
      qtyMinus.addEventListener('click', () => {
        if (currentQty > 1) {
          currentQty--;
          qtyDisplay.textContent = currentQty;
          updateModalPrice();
        }
      });
    }

    if (qtyPlus) {
      qtyPlus.addEventListener('click', () => {
        currentQty++;
        qtyDisplay.textContent = currentQty;
        updateModalPrice();
      });
    }

    // Direct WhatsApp Purchase with Name, DNI, Address
    if (btnWaSubmit) {
      btnWaSubmit.addEventListener('click', () => {
        if (!currentProduct) return;

        const name = inputName ? inputName.value.trim() : '';
        const dni = inputDni ? inputDni.value.trim() : '';
        const city = inputCity ? inputCity.value.trim() : '';
        const address = inputAddress ? inputAddress.value.trim() : '';
        const customNote = customInput ? customInput.value.trim() : '';

        if (!name || !dni || !address) {
          if (formError) formError.classList.remove('hidden');
          return;
        }

        if (formError) formError.classList.add('hidden');

        const totalAmount = (currentProduct.precio * currentQty).toFixed(2);

        let msg = `*NUEVA COMPRA - JOYERÍA BRIELLA*\n`;
        msg += `------------------------------------\n`;
        msg += `*Producto:* ${currentQty}x *${currentProduct.nombre}*\n`;
        msg += `*Material:* ${currentProduct.material}\n`;
        msg += `*Precio Total:* S/ ${totalAmount}\n`;
        if (customNote) {
          msg += `*Grabado/Detalle:* "${customNote}"\n`;
        }
        msg += `------------------------------------\n`;
        msg += `*DATOS DE ENVÍO:*\n`;
        msg += `• *Cliente:* ${name}\n`;
        msg += `• *DNI/Doc:* ${dni}\n`;
        msg += `• *Ciudad/Distrito:* ${city || 'Por coordinar'}\n`;
        msg += `• *Dirección:* ${address}\n`;
        msg += `• *Medio de Pago:* Yape / Plin / Transferencia\n\n`;
        msg += `¡Hola Joyería Briella! Acabo de completar mis datos para comprar esta joya. ¿Me confirman el pago y fecha de entrega?`;

        const waUrl = `https://wa.me/51923340617?text=${encodeURIComponent(msg)}`;
        window.open(waUrl, '_blank');
        closeModal();
      });
    }

    // Add to Cart
    if (btnAdd) {
      btnAdd.addEventListener('click', () => {
        if (!currentProduct) return;
        const customNote = customInput ? customInput.value.trim() : '';
        if (window.BriellaCartClient) {
          window.BriellaCartClient.addItem(currentProduct, currentQty, customNote);
        }
        closeModal();
      });
    }

    // Bind triggers from product cards
    document.querySelectorAll('.product-open-modal').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const card = trigger.closest('.product-card');
        const jsonStr = card?.querySelector('.btn-buy-now')?.dataset.productJson;
        if (jsonStr) {
          const product = JSON.parse(jsonStr);
          window.openProductModal(product);
        }
      });
    });

  });
</script>
