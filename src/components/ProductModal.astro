          <label
            id="modalVoucherDropzone"
            class="w-full border-2 border-dashed border-briella-cream-dark hover:border-briella-purple bg-[#FAF9F6] rounded-xl p-3.5 flex flex-col items-center justify-center cursor-pointer transition-colors text-center"
          >
            <input
