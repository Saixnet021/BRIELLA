---
// src/components/ProductModal.astro
---

<!-- Unified 3-Step Checkout Modal for SM Joyería (Single Item & Multi-Item Cart) -->
<div
  id="productDetailModal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-briella-charcoal/70 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div
    class="relative w-full max-w-2xl bg-white rounded-2xl border border-briella-cream-dark shadow-2xl max-h-[94vh] flex flex-col overflow-hidden"
  >
    <!-- Top Header -->
    <div
      class="p-4 sm:p-5 border-b border-briella-cream-dark flex items-center justify-between bg-white"
    >
      <div>
        <h2
          id="checkoutModalMainTitle"
          class="font-serif text-lg sm:text-xl font-bold tracking-tight text-briella-charcoal"
        >
          FINALIZAR COMPRA — SM JOYERÍA
        </h2>
        <p
          class="text-[10px] sm:text-[11px] uppercase tracking-widest text-briella-charcoal/60 font-semibold mt-0.5"
        >
          INGRESA TUS DATOS DE ENVÍO Y MÉTODO DE PAGO
        </p>
      </div>

      <button
        id="btnModalClose"
        type="button"
        class="w-8 h-8 rounded-lg bg-briella-cream hover:bg-briella-charcoal hover:text-white flex items-center justify-center text-briella-charcoal transition-colors focus:outline-none"
        aria-label="Cerrar modal"
      >
        <svg
          class="w-4 h-4 stroke-[2]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Stepper Navigation (Paso 1: ENVÍO | Paso 2: PAGO | Paso 3: CONFIRMAR) -->
    <div
      id="modalStepperBar"
      class="px-6 py-3 bg-briella-cream border-b border-briella-cream-dark"
    >
      <div class="max-w-md mx-auto flex items-center justify-between relative">
        <!-- Step 1 Indicator -->
        <div class="flex flex-col items-center gap-1 z-10">
          <div
            id="stepperCircle1"
            class="w-7 h-7 rounded-full bg-briella-purple text-white flex items-center justify-center text-xs font-bold transition-all shadow-xs"
          >
            <svg
              id="stepperCheck1"
              class="w-3.5 h-3.5 stroke-[2.5] hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span id="stepperNum1">1</span>
          </div>
          <span
            id="stepperText1"
            class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal"
            >ENVÍO</span
          >
        </div>

        <!-- Connecting Line 1 -->
        <div class="flex-1 h-0.5 mx-2 bg-briella-cream-dark relative">
          <div
            id="stepperLine1"
            class="h-full bg-briella-purple w-0 transition-all duration-300"
          >
          </div>
        </div>

        <!-- Step 2 Indicator -->
        <div class="flex flex-col items-center gap-1 z-10">
          <div
            id="stepperCircle2"
            class="w-7 h-7 rounded-full bg-briella-cream-dark text-briella-charcoal/60 flex items-center justify-center text-xs font-bold transition-all"
          >
            <svg
              id="stepperCheck2"
              class="w-3.5 h-3.5 stroke-[2.5] hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <svg
              id="stepperCard2"
              class="w-3.5 h-3.5 stroke-[2]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <span
            id="stepperText2"
            class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/50"
            >PAGO</span
          >
        </div>

        <!-- Connecting Line 2 -->
        <div class="flex-1 h-0.5 mx-2 bg-briella-cream-dark relative">
          <div
            id="stepperLine2"
            class="h-full bg-briella-purple w-0 transition-all duration-300"
          >
          </div>
        </div>

        <!-- Step 3 Indicator -->
        <div class="flex flex-col items-center gap-1 z-10">
          <div
            id="stepperCircle3"
            class="w-7 h-7 rounded-full bg-briella-cream-dark text-briella-charcoal/60 flex items-center justify-center text-xs font-bold transition-all"
          >
            <svg
              class="w-3.5 h-3.5 stroke-[2]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </div>
          <span
            id="stepperText3"
            class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/50"
            >CONFIRMAR</span
          >
        </div>
      </div>
    </div>

    <!-- Scrollable Modal Body -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-6">
      <!-- ============================================== -->
      <!-- PASO 1: DATOS DE ENVÍO & DETALLES DE PRODUCTOS -->
      <!-- ============================================== -->
      <div id="modalStep1Content" class="space-y-4">
        <!-- Empty Cart Message (if in Cart mode and empty) -->
        <div
          id="modalEmptyCartNotice"
          class="hidden text-center py-8 bg-briella-cream-light rounded-xl border border-briella-cream-dark p-6"
        >
          <div
            class="w-12 h-12 rounded-full bg-briella-cream flex items-center justify-center mx-auto mb-2 text-briella-purple"
          >
            <svg
              class="w-6 h-6 stroke-[1.5]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
              ></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <h4 class="font-serif text-base font-bold text-briella-charcoal">
            Tu bolsa de compras está vacía
          </h4>
          <p
            class="text-xs text-briella-charcoal/60 max-w-xs mx-auto mt-1 mb-4"
          >
            Agrega joyas desde el catálogo para finalizar tu compra.
          </p>
          <a
            href="#catalogo"
            id="btnModalExploreCatalog"
            class="inline-block px-5 py-2 rounded-lg bg-briella-purple hover:bg-briella-purple-dark text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
          >
            Ver Catálogo de Joyas
          </a>
        </div>

        <!-- Single Product Mode Card -->
        <div
          id="modalSingleProductBox"
          class="flex items-center gap-3.5 p-3 rounded-xl bg-briella-cream border border-briella-cream-dark"
        >
          <div
            class="w-16 h-16 sm:w-18 sm:h-18 rounded-lg overflow-hidden bg-white flex-shrink-0 border border-briella-cream-dark"
          >
            <img
              id="modalProductImg"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
          </div>

          <div class="flex-1 min-w-0">
            <span
              id="modalProductBadge"
              class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-briella-purple-light text-briella-purple inline-block mb-1"
            ></span>
            <h3
              id="modalProductTitle"
              class="font-serif text-sm sm:text-base font-semibold text-briella-charcoal truncate"
            >
            </h3>
            <div
              class="text-xs font-bold font-sans text-briella-charcoal mt-0.5"
            >
              Precio Unitario: <span class="text-briella-purple font-semibold"
                >S/ <span id="modalProductUnitPrice"></span></span
              >
            </div>
          </div>

          <!-- Quantity Control -->
          <div
            class="flex items-center border border-briella-cream-dark bg-white rounded-lg overflow-hidden p-0.5 flex-shrink-0"
          >
            <button
              id="modalQtyMinus"
              type="button"
              class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center font-bold text-xs rounded hover:bg-briella-cream active:scale-95 transition-colors"
              >-</button
            >
            <span
              id="modalQtyDisplay"
              class="w-6 sm:w-7 text-center text-xs font-bold font-sans">1</span
            >
            <button
              id="modalQtyPlus"
              type="button"
              class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center font-bold text-xs rounded hover:bg-briella-cream active:scale-95 transition-colors"
              >+</button
            >
          </div>
        </div>

        <!-- Multi-Item Cart List Container (Cart Mode) -->
        <div
          id="modalCartItemsList"
          class="hidden space-y-2.5 max-h-56 overflow-y-auto pr-1"
        >
          <!-- Injected dynamically by Script -->
        </div>

        <!-- TOTAL BAR (Orchid Purple Gradient matching brand design) -->
        <div
          id="modalStep1TotalBar"
          class="bg-gradient-to-r from-briella-purple to-briella-purple-dark text-white rounded-xl p-3.5 px-4 flex items-center justify-between shadow-xs"
        >
          <span
            class="text-xs font-bold uppercase tracking-widest text-white/90"
            >TOTAL A PAGAR:</span
          >
          <span class="text-lg sm:text-xl font-bold font-sans text-white"
            >S/ <span id="modalStep1Total">0.00</span></span
          >
        </div>

        <!-- Shipping & Customer Form -->
        <div id="modalStep1FormFields" class="space-y-3">
          <div
            class="text-[11px] font-bold uppercase tracking-wider text-briella-charcoal/80 flex items-center gap-1.5"
          >
            <svg
              class="w-3.5 h-3.5 text-briella-purple stroke-[2]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Datos para la Entrega:</span>
          </div>

          <div>
            <label
              for="modalInputName"
              class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
              >Nombre y Apellidos *</label
            >
            <input
              type="text"
              id="modalInputName"
              placeholder="Ej. Camila Morales"
              required
              class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label
                for="modalInputDni"
                class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
                >DNI / Documento *</label
              >
              <input
                type="text"
                id="modalInputDni"
                placeholder="DNI o Cédula"
                maxlength="12"
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
              />
            </div>
            <div>
              <label
                for="modalInputPhone"
                class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
                >Teléfono / WhatsApp *</label
              >
              <input
                type="tel"
                id="modalInputPhone"
                placeholder="Ej. 984018633"
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label
                for="modalInputCity"
                class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
                >Ciudad / Distrito *</label
              >
              <input
                type="text"
                id="modalInputCity"
                placeholder="Ej. Piura / Miraflores, Lima"
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
              />
            </div>
            <div>
              <label
                for="modalInputAddress"
                class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
                >Dirección de Entrega *</label
              >
              <input
                type="text"
                id="modalInputAddress"
                placeholder="Av. / Calle, Nro, Dpto"
                required
                class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
              />
            </div>
          </div>

          <!-- Optional Engraving Note -->
          <div id="modalCustomNoteBox" class="hidden">
            <label
              for="modalCustomInput"
              class="block text-[10px] font-bold uppercase tracking-wider text-briella-charcoal/70 mb-1"
              >Nombre o Grabado deseado (Opcional)</label
            >
            <input
              type="text"
              id="modalCustomInput"
              placeholder="Ej. 'Neyh', fecha o iniciales..."
              class="w-full bg-[#FAF9F6] text-xs py-2.5 px-3.5 rounded-lg border border-briella-cream-dark focus:border-briella-purple focus:bg-white outline-none transition-colors"
            />
          </div>

          <p
            id="modalStep1Error"
            class="hidden text-[11px] text-red-600 font-bold bg-red-50 p-2.5 rounded-lg border border-red-200"
          >
            Por favor ingresa tu Nombre, DNI, Teléfono y Dirección para
            continuar al pago.
          </p>
        </div>

        <!-- Actions Step 1 -->
        <div
          id="modalStep1Actions"
          class="pt-3 border-t border-briella-cream-dark space-y-2"
        >
          <button
            id="btnModalGoToStep2"
            type="button"
            class="w-full bg-briella-purple hover:bg-briella-purple-dark active:scale-[0.98] text-white py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-widest transition-all shadow-md flex items-center justify-center gap-2"
          >
            <span>CONTINUAR AL PAGO</span>
            <svg
              class="w-4 h-4 stroke-[2]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <!-- Short concise Add to Cart button -->
          <button
            id="btnModalAddToCart"
            type="button"
            class="w-full bg-briella-cream hover:bg-briella-cream-dark active:scale-[0.98] text-briella-charcoal border border-briella-cream-dark py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-2"
          >
            <svg
              class="w-3.5 h-3.5 stroke-[1.5]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
              ></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Añadir a la Bolsa</span>
          </button>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- PASO 2: PAGO, YAPE/PLIN & VOUCHER              -->
      <!-- ============================================== -->
      <div id="modalStep2Content" class="hidden space-y-4">
        <!-- Order Summary Box -->
        <div
          class="border border-briella-cream-dark rounded-xl p-3 bg-white shadow-xs"
        >
          <div
            class="flex items-center justify-between pb-2 mb-2 border-b border-briella-cream-dark/60"
          >
            <span
              class="text-[10px] uppercase font-bold tracking-wider text-briella-charcoal/70 flex items-center gap-1.5"
            >
              <svg
                class="w-3.5 h-3.5 text-briella-purple"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                ></path>
              </svg>
              RESUMEN DEL PEDIDO
            </span>
            <span class="text-[10px] text-briella-charcoal/50 font-semibold"
              >PASO 2 DE 3</span
            >
          </div>

          <div
            id="modalStep2ItemsList"
            class="space-y-2 max-h-36 overflow-y-auto pr-1"
          >
            <!-- Dynamic items summary list -->
          </div>
        </div>

        <!-- TOTAL BAR (Orchid Purple Gradient) -->
        <div
          class="bg-gradient-to-r from-briella-purple to-briella-purple-dark text-white rounded-xl p-3.5 px-4 flex items-center justify-between shadow-xs"
        >
          <span
            class="text-xs font-bold uppercase tracking-widest text-white/90"
            >TOTAL A PAGAR</span
          >
          <span class="text-lg sm:text-xl font-bold font-sans text-white"
            >S/ <span id="modalStep2GrandTotal">0.00</span></span
          >
        </div>

        <!-- MODO DEMOSTRACIÓN (Demo Bypass) -->
        <div
          class="bg-briella-cream-light border border-briella-cream-dark rounded-xl p-3.5 space-y-2"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span
                class="text-[11px] font-bold uppercase tracking-wider text-briella-charcoal"
                >MODO DEMOSTRACIÓN</span
              >
            </div>
          </div>
          <p class="text-[11px] text-briella-charcoal/70 leading-relaxed">
            ¿Estás probando esta demo? Dale clic para simular el pago y
            comprobante automáticamente.
          </p>
          <button
            id="btnModalAutoFillVoucher"
            type="button"
            class="w-full bg-white hover:bg-briella-cream active:scale-[0.99] border border-briella-cream-dark py-2 px-3 rounded-lg text-xs font-bold uppercase tracking-wider text-briella-charcoal transition-all flex items-center justify-center gap-1.5 shadow-xs"
          >
            <svg
              class="w-3.5 h-3.5 text-amber-500 fill-current"
              viewBox="0 0 24 24"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
            <span>AUTOCOMPLETAR VOUCHER</span>
          </button>
        </div>

        <!-- PAGAR CON YAPE O PLIN Card -->
        <div
          class="bg-white border border-briella-cream-dark rounded-xl p-3.5 space-y-3 shadow-xs"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <svg
                class="w-4 h-4 text-briella-purple"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span
                class="text-[11px] font-bold uppercase tracking-wider text-briella-charcoal"
                >PAGAR CON YAPE O PLIN</span
              >
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-briella-cream text-briella-charcoal/70"
            >
              TITULAR: SM JOYERÍA
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <!-- QR Graphic -->
            <div
              class="sm:col-span-4 bg-[#FAF9F6] border border-briella-cream-dark rounded-lg p-2 flex flex-col items-center justify-center text-center"
            >
              <div
                class="w-18 h-18 bg-white p-1 rounded border border-briella-cream-dark flex items-center justify-center"
              >
                <svg
                  class="w-full h-full text-briella-charcoal"
                  viewBox="0 0 33 33"
                  fill="currentColor"
                >
                  <path
                    d="M0 0h9v9H0zM2 2h5v5H2zM24 0h9v9h-9zM26 2h5v5h-5zM0 24h9v9H0zM2 26h5v5H2zM12 2h2v4h-2zM16 0h2v6h-2zM12 8h6v2h-6zM4 12h4v2H4zM0 16h6v2H0zM8 16h4v2H8zM14 12h4v4h-4zM2 20h2v2H2zM20 12h4v2h-4zM26 12h2v4h-2zM30 12h3v2h-3zM24 16h4v2h-4zM20 18h2v4h-2zM16 20h2v4h-2zM24 20h2v2h-2zM28 20h4v2h-4zM12 24h2v2h-2zM18 24h4v2h-4zM14 28h2v5h-2zM20 28h2v2h-2zM24 26h2v4h-2zM28 26h2v2h-2zM30 30h3v3h-3zM26 31h2v2h-2zM20 32h2v1h-2z"
                  ></path>
                </svg>
              </div>
              <span
                class="text-[9px] font-bold uppercase tracking-wider text-briella-charcoal/60 mt-1"
                >ESCANEAR QR</span
              >
            </div>

            <!-- Number & Copy Box -->
            <div class="sm:col-span-8 space-y-2">
              <div
                class="bg-[#FAF9F6] border border-briella-cream-dark rounded-lg p-2.5 flex items-center justify-between"
              >
                <div>
                  <span
                    class="text-[9px] font-bold uppercase tracking-wider text-briella-charcoal/50 block"
                    >YAPE / PLIN</span
                  >
                  <span
                    class="text-sm sm:text-base font-bold font-sans text-briella-charcoal tracking-wide"
                    >984 018 633</span
                  >
                </div>
                <button
                  id="btnModalCopyNumber"
                  type="button"
                  class="px-2.5 py-1.5 bg-white hover:bg-briella-cream active:scale-95 border border-briella-cream-dark rounded-md text-xs font-bold uppercase tracking-wider text-briella-charcoal transition-all flex items-center gap-1 shadow-xs"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
