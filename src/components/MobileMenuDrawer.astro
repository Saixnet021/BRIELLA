---
// src/components/MobileMenuDrawer.astro
---

<!-- Fullscreen Mobile Navigation Drawer (Top Z-Index Layer) -->
<div 
  id="mobileNavBackdrop" 
  class="fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog" 
  aria-modal="true" 
  aria-hidden="true"
>
  <div 
    id="mobileNavDrawer" 
    class="fixed top-0 left-0 bottom-0 w-[85vw] max-w-sm bg-white z-[101] shadow-2xl flex flex-col justify-between overflow-y-auto transform -translate-x-full transition-transform duration-300 ease-in-out"
  >
    
    <div class="p-5 sm:p-6">
      <!-- Top Close Bar -->
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-neutral-100">
        <button 
          id="btnDrawerCloseIcon" 
          type="button" 
          class="p-1 -ml-1 text-neutral-900 hover:text-neutral-600 active:scale-95 transition-all focus:outline-none"
          aria-label="Cerrar menú"
        >
          <svg class="w-6 h-6 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <img src="assets/images/logo.svg" alt="SM Joyería" class="h-7 w-auto" />
      </div>

      <!-- Drawer Search Input -->
      <div class="mb-5">
        <div class="relative w-full">
          <input 
            type="text" 
            id="mobileDrawerSearchInput" 
            placeholder="Buscar aretes, anillos, cadenas..." 
            class="w-full bg-[#F6F6F6] text-xs py-3 pl-4 pr-10 rounded-xl border border-neutral-200 focus:border-briella-blue focus:bg-white transition-all outline-none placeholder:text-neutral-400 font-sans"
          />
          <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>

      <!-- Category Links List (Exact Reference Layout) -->
      <div class="flex flex-col text-[13px] font-bold uppercase tracking-wider text-neutral-900 divide-y divide-neutral-100">
        
        <!-- 1. LAST CHANCE -->
        <a href="#catalogo" data-drawer-category="todos" class="py-3 text-briella-rose-dark hover:text-briella-rose transition-colors drawer-link flex items-center justify-between">
          <span>COLECCIÓN EXCLUSIVA</span>
        </a>

        <!-- 2. LO NUEVO -->
        <a href="#catalogo" data-drawer-category="todos" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between">
          <span>LO MÁS PEDIDO</span>
        </a>

        <!-- 3. PLATA LEY 950 -->
        <a href="#catalogo" data-drawer-material="plata 950" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>PLATA LEY 950</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 4. ORO 18K -->
        <a href="#catalogo" data-drawer-material="oro 18k" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>ORO 18K &amp; COMPROMISO</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 5. ARETES -->
        <a href="#catalogo" data-drawer-category="aretes" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>ARETES</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 6. COLLARES -->
        <a href="#catalogo" data-drawer-category="collares" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>COLLARES &amp; CADENAS</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 7. PULSERAS -->
        <a href="#catalogo" data-drawer-category="pulseras" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>PULSERAS &amp; TOBILLERAS</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 8. ANILLOS -->
        <a href="#catalogo" data-drawer-category="anillos" class="py-3 hover:text-briella-blue transition-colors drawer-link flex items-center justify-between group">
          <span>ANILLOS &amp; SOLITARIOS</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 9. JOYAS PERSONALIZADAS -->
        <a href="#personalizados" class="py-3 text-briella-blue hover:text-briella-blue-dark transition-colors drawer-link flex items-center justify-between group">
          <span>JOYAS PERSONALIZADAS ✨</span>
          <svg class="w-4 h-4 text-briella-blue group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- 10. WHATSAPP -->
        <a 
          href="https://wa.me/51984018633?text=¡Hola%20SM%20Joyería!%20Deseo%20consultar%20sobre%20su%20catálogo%20de%20joyas." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="py-3 hover:text-briella-whatsapp transition-colors drawer-link flex items-center justify-between group"
        >
          <span>PEDIDOS &amp; WHATSAPP</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-briella-whatsapp group-hover:translate-x-0.5 transition-all stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

      </div>
    </div>

    <!-- Drawer Footer Branding -->
    <div class="p-5 sm:p-6 border-t border-neutral-100 bg-[#FAF9F6]">
      <p class="text-[10px] text-neutral-500 tracking-wider uppercase font-semibold">Taller SM Joyería &bull; Joyería Fina en Perú</p>
      <p class="text-[9px] text-neutral-400 mt-0.5">Oro 18k y Plata Ley 950 con envíos a todo el Perú</p>
    </div>

  </div>
</div>

<script is:inline>
  window.BriellaMobileMenu = {
    open() {
      const backdrop = document.getElementById('mobileNavBackdrop');
      const drawer = document.getElementById('mobileNavDrawer');
      if (backdrop && drawer) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        drawer.classList.remove('-translate-x-full');
        drawer.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
      }
    },

    close() {
      const backdrop = document.getElementById('mobileNavBackdrop');
      const drawer = document.getElementById('mobileNavDrawer');
      if (backdrop && drawer) {
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('-translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    },

    init() {
      const backdrop = document.getElementById('mobileNavBackdrop');
      const closeBtn = document.getElementById('btnDrawerCloseIcon');
      const searchInput = document.getElementById('mobileDrawerSearchInput');

      if (closeBtn) closeBtn.addEventListener('click', () => this.close());
      if (backdrop) {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop) this.close();
        });
      }

      // Drawer links interaction
      document.querySelectorAll('.drawer-link').forEach(link => {
        link.addEventListener('click', () => {
          const cat = link.dataset.drawerCategory;
          const mat = link.dataset.drawerMaterial;

          if (cat) {
            const catBtn = document.querySelector(`.filter-category-btn[data-category="${cat}"]`);
            if (catBtn) catBtn.click();
          }

          if (mat) {
            const matBtn = document.querySelector(`.filter-material-btn[data-material="${mat}"]`);
            if (matBtn) matBtn.click();
          }

          this.close();
        });
      });

      // Search integration
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const val = e.target.value;
          const catSearch = document.getElementById('catalogSearchInput');
          if (catSearch) {
            catSearch.value = val;
            catSearch.dispatchEvent(new Event('input', { bubbles: true }));
          }
        });

        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            this.close();
            const catalogEl = document.getElementById('catalogo');
            if (catalogEl) catalogEl.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    window.BriellaMobileMenu.init();
  });
</script>
