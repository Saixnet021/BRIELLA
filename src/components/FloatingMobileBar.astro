---
// src/components/FloatingMobileBar.astro
---

<!-- Floating Bottom Bar for Mobile Devices -->
<div class="sm:hidden fixed bottom-3 inset-x-3 z-40 max-w-xs mx-auto">
  <div class="bg-white/95 backdrop-blur-md border border-briella-cream-dark/90 shadow-floating rounded-full px-4 py-2 flex items-center justify-between text-briella-charcoal">
    
    <!-- Home Link -->
    <a 
      href="#hero" 
      class="flex flex-col items-center justify-center p-1.5 text-briella-charcoal/70 hover:text-briella-blue transition-colors focus:outline-none"
      aria-label="Ir al inicio"
    >
      <svg class="w-5 h-5 stroke-[1.75]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span class="text-[9px] font-medium tracking-wider uppercase mt-0.5">Inicio</span>
    </a>

    <!-- Open Filter Button -->
    <button 
      id="btnMobileBarFilter" 
      type="button"
      class="flex flex-col items-center justify-center p-1.5 text-briella-charcoal/70 hover:text-briella-blue transition-colors focus:outline-none"
      aria-label="Abrir filtros de catálogo"
    >
      <svg class="w-5 h-5 stroke-[1.75]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
        <line x1="1" y1="14" x2="7" y2="14"></line>
        <line x1="9" y1="8" x2="15" y2="8"></line>
        <line x1="17" y1="16" x2="23" y2="16"></line>
      </svg>
      <span class="text-[9px] font-medium tracking-wider uppercase mt-0.5">Filtros</span>
    </button>

    <!-- Shopping Bag Trigger with Live Counter -->
    <button 
      id="btnMobileBarCart" 
      type="button"
      class="relative flex flex-col items-center justify-center p-1.5 text-briella-blue font-semibold focus:outline-none"
      aria-label="Ver bolsa de compras"
    >
      <div class="relative">
        <svg class="w-5 h-5 stroke-[1.75]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span 
          id="mobileBarCartBadge" 
          class="absolute -top-1 -right-2 min-w-4 h-4 px-1 bg-briella-blue text-white text-[9px] font-bold rounded-full flex items-center justify-center"
        >0</span>
      </div>
      <span class="text-[9px] font-bold tracking-wider uppercase mt-0.5">Bolsa</span>
    </button>

    <!-- WhatsApp Direct Link -->
    <a 
      href="https://wa.me/51923340617?text=¡Hola%20Joyería%20Briella!%20Deseo%20consultar%20sobre%20su%20catálogo%20de%20joyas." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex flex-col items-center justify-center p-1.5 text-briella-whatsapp hover:scale-105 transition-all focus:outline-none"
      aria-label="Escribir por WhatsApp"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7 8.98 7 10.21C7 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"/>
      </svg>
      <span class="text-[9px] font-bold tracking-wider uppercase mt-0.5">Chat</span>
    </a>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileCartBtn = document.getElementById('btnMobileBarCart');
    const mobileFilterBtn = document.getElementById('btnMobileBarFilter');

    if (mobileCartBtn) {
      mobileCartBtn.addEventListener('click', () => {
        if (window.BriellaCartClient) {
          window.BriellaCartClient.open();
        }
      });
    }

    if (mobileFilterBtn) {
      mobileFilterBtn.addEventListener('click', () => {
        const drawerTrigger = document.getElementById('btnOpenMobileFilters');
        if (drawerTrigger) {
          drawerTrigger.click();
        } else {
          const catalogEl = document.getElementById('catalogo');
          if (catalogEl) catalogEl.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  });
</script>
