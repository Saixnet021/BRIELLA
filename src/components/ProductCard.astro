---
// src/components/ProductCard.astro
interface Props {
  product: {
    id: string;
    nombre: string;
    categoria: string;
    material: string;
    precio: number;
    imagen: string;
    descripcion_corta: string;
    destacado?: boolean;
    es_personalizable?: boolean;
    badge?: string;
  };
  index?: number;
}

const { product, index = 0 } = Astro.props;
const isGold = product.material.toLowerCase().includes("oro");
---

<article
  class="product-card card-reveal-item group bg-white rounded-xl border border-briella-cream-dark hover:border-briella-blue/40 shadow-xs hover:shadow-card transition-all duration-300 flex flex-col justify-between p-3 sm:p-4 will-change-transform"
  data-id={product.id}
  data-category={product.categoria}
  data-material={product.material}
  data-price={product.precio}
  data-name={product.nombre}
  data-index={index}
>
  <!-- Media / Image Container -->
  <div
    class="relative w-full aspect-square bg-[#FAF8F5] rounded-lg overflow-hidden cursor-pointer product-open-modal mb-3"
  >
    <img
      src={product.imagen}
      alt={product.nombre}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      width="300"
      height="300"
    />

    <!-- Single Material Badge: Only PLATA 950 or ORO 18K -->
    <div class="absolute top-2.5 left-2.5 z-10 pointer-events-none">
      {isGold ? (
        <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-briella-gold-light text-briella-gold-dark shadow-xs border border-amber-200/70">
          ORO 18K
        </span>
      ) : (
        <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-briella-blue-light text-briella-blue-dark shadow-xs border border-slate-200/70">
          PLATA 950
        </span>
      )}
    </div>

    <!-- Quick View Hover Overlay (Desktop) -->
    <button
      type="button"
      class="hidden md:flex items-center gap-1.5 absolute bottom-3 left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-sm text-briella-charcoal text-[11px] font-bold uppercase tracking-wider py-1.5 px-3.5 rounded-lg border border-briella-cream-dark shadow-xs opacity-0 group-hover:opacity-100 transition-all hover:bg-briella-blue hover:text-white hover:border-briella-blue"
      aria-label={`Ver detalles de ${product.nombre}`}
    >
      <svg
        class="w-3.5 h-3.5 stroke-[1.75]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
      >
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="4"></circle>
      </svg>
      <span>Detalles</span>
    </button>
  </div>

  <!-- Body Content -->
  <div class="flex flex-col flex-grow justify-between">
    <div>
      <h3
        class="font-serif text-xs sm:text-sm md:text-base font-medium text-briella-charcoal line-clamp-2 cursor-pointer hover:text-briella-blue transition-colors product-open-modal leading-snug mb-1 text-center sm:text-left min-h-[2.4em]"
      >
        {product.nombre}
      </h3>

      <p
        class="text-[11px] text-briella-charcoal/60 line-clamp-1 mb-2 leading-relaxed hidden sm:block"
      >
        {product.descripcion_corta}
      </p>
    </div>

    <div>
      <!-- Price Row -->
      <div class="flex items-baseline justify-center sm:justify-start gap-1 mb-2.5">
        <span class="text-xs font-bold text-briella-blue">S/</span>
        <span class="text-sm sm:text-base md:text-lg font-bold font-sans text-briella-charcoal">
          {product.precio.toFixed(2)}
        </span>
      </div>

      <!-- Action Buttons Row -->
      <div class="flex items-center gap-1.5 pt-2 border-t border-briella-cream-dark/60">
        
        <!-- Primary COMPRAR Button -->
        <button
          type="button"
          class="btn-buy-now product-open-modal flex-1 inline-flex items-center justify-center gap-1.5 bg-gradient-to-r from-briella-purple to-briella-purple-dark hover:brightness-105 active:scale-95 text-white text-xs font-bold uppercase tracking-wider py-2 px-3 rounded-lg shadow-xs transition-all"
          data-product-json={JSON.stringify(product)}
          aria-label={`Comprar ${product.nombre}`}
        >
          <span>Comprar</span>
        </button>

        <!-- Add to Cart -->
        <button
          type="button"
          class="btn-add-to-cart inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-briella-cream hover:bg-briella-cream-dark active:scale-95 text-briella-charcoal border border-briella-cream-dark transition-all shadow-xs flex-shrink-0"
          data-product-json={JSON.stringify(product)}
          aria-label={`Añadir ${product.nombre} a la bolsa`}
          title="Añadir a la bolsa de compras"
        >
          <svg
            class="w-4 h-4 stroke-[1.75] text-briella-charcoal"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </button>

      </div>
    </div>
  </div>
</article>
