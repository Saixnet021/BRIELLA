---
// src/components/Hero.astro
const slides = [
  {
    image: "assets/images/hero-banner.jpg",
    tag: "COLECCIÓN EXCLUSIVA 2026",
    title: "Joyas con alma para brillar",
    subtitle: "Plata Ley 950 &amp; Oro 18k &bull; Joyería fina artesanal con envíos seguros a todo el Perú.",
    linkText: "VER CATÁLOGO",
    linkUrl: "#catalogo"
  },
  {
    image: "assets/images/personalizado-01.jpg",
    tag: "TALLER SM JOYERÍA",
    title: "Tu Historia Hecha Joya",
    subtitle: "Nombres calados, siluetas de mascotas y grabados personalizados hechos a mano.",
    linkText: "PERSONALIZADOS",
    linkUrl: "#personalizados"
  }
];
---

<section id="hero" class="relative w-full bg-briella-cream p-3 sm:p-0 border-b border-briella-cream-dark">
  
  <!-- Responsive Carousel Container: App Card on Mobile (<sm), 100% Full-Bleed Edge-to-Edge on PC (sm+) -->
  <div id="heroCarousel" class="relative w-full h-[460px] sm:h-[480px] md:h-[540px] lg:h-[580px] rounded-2xl sm:rounded-none overflow-hidden shadow-sm sm:shadow-none bg-black">
    
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-slide-index={index}
      >
        <!-- Full-bleed background image spanning 100% edge-to-edge -->
        <img 
          src={slide.image} 
          alt={slide.title} 
          class="w-full h-full object-cover object-center"
          loading={index === 0 ? "eager" : "lazy"}
        />
        
        <!-- Smooth gradient vignette: bottom-to-top on mobile, left-to-right on desktop -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/15 md:bg-gradient-to-r md:from-black/85 md:via-black/50 md:to-transparent"></div>

        <!-- Editorial Text Overlay (Bottom aligned on mobile, centered within max-w-7xl on desktop) -->
        <div class="absolute inset-0 flex items-end sm:items-center p-5 sm:p-12 lg:p-16 z-20">
          <div class="max-w-7xl mx-auto w-full">
            <div class="max-w-xl text-white space-y-2.5 sm:space-y-3.5 pb-2 sm:pb-0">
              
              <!-- Clean Minimalist Tag -->
              <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-[#E3D9C6] block">
                {slide.tag}
              </span>

              <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-white leading-tight">
                {slide.title}
              </h2>

              <p class="text-xs sm:text-sm text-white/85 max-w-md leading-relaxed font-light line-clamp-2" set:html={slide.subtitle} />

              <div class="pt-2 sm:pt-3">
                <a 
                  href={slide.linkUrl} 
                  class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-briella-charcoal bg-white hover:bg-briella-cream active:scale-95 px-6 py-3 rounded-full transition-all shadow-md"
                >
                  <span>{slide.linkText}</span>
                  <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>

            </div>
          </div>
        </div>

      </div>
    ))}

    <!-- Top Right Status Dots Indicator (Mobile App Glass Pill) -->
    <div class="absolute top-4 right-4 z-30 bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-full flex items-center gap-1.5 border border-white/10">
      {slides.map((_, i) => (
        <button 
          class={`hero-dot rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-4 h-1.5' : 'bg-white/40 w-1.5 h-1.5 hover:bg-white/70'}`}
          data-dot-index={i}
          aria-label={`Ir al slide ${i + 1}`}
        />
      ))}
    </div>

    <!-- Prev & Next Floating Circular Arrow Buttons -->
    <button 
      id="heroBtnPrev" 
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 text-white flex items-center justify-center transition-all focus:outline-none shadow-sm active:scale-95"
      aria-label="Slide anterior"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button 
      id="heroBtnNext" 
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 text-white flex items-center justify-center transition-all focus:outline-none shadow-sm active:scale-95"
      aria-label="Siguiente slide"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

  </div>

</section>

<!-- Carousel Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    const btnPrev = document.getElementById('heroBtnPrev');
    const btnNext = document.getElementById('heroBtnNext');

    if (!slides.length) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.className = 'hero-dot bg-white w-4 h-1.5 rounded-full transition-all duration-300';
        } else {
          dot.className = 'hero-dot bg-white/40 w-1.5 h-1.5 rounded-full hover:bg-white/70 transition-all duration-300';
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        prevSlide();
        startAutoPlay();
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        nextSlide();
        startAutoPlay();
      });
    }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.dataset.dotIndex || '0', 10);
        goToSlide(idx);
        startAutoPlay();
      });
    });

    const carousel = document.getElementById('heroCarousel');
    if (carousel) {
      carousel.addEventListener('mouseenter', stopAutoPlay);
      carousel.addEventListener('mouseleave', startAutoPlay);

      // Touch swipe support for mobile
      let touchStartX = 0;
      let touchEndX = 0;

      carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoPlay();
      }, { passive: true });

      carousel.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) {
          nextSlide();
        } else if (touchEndX - touchStartX > 45) {
          prevSlide();
        }
        startAutoPlay();
      }, { passive: true });
    }

    startAutoPlay();
  });
</script>
