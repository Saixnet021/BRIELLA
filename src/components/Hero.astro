---
// src/components/Hero.astro
const slides = [
  {
    image: "assets/images/hero-banner.jpg",
    tag: "COLECCIÓN EXCLUSIVA 2026",
    title: "Joyas con alma para brillar",
    subtitle: "Plata Ley 950 &bull; Acabados artesanales de alta joyería",
    linkText: "Ver Catálogo",
    linkUrl: "#catalogo"
  },
  {
    image: "assets/images/personalizado-01.jpg",
    tag: "TALLER BRIELLA",
    title: "Tu Historia Hecha Joya",
    subtitle: "Nombres calados, siluetas de mascotas y grabados",
    linkText: "Joyas Personalizadas",
    linkUrl: "#personalizados"
  }
];
---

<section id="hero" class="relative w-full overflow-hidden bg-briella-charcoal border-b border-briella-cream-dark">
  
  <!-- Responsive Full-Width Carousel Container -->
  <div id="heroCarousel" class="relative w-full h-[360px] sm:h-[420px] md:h-[480px] lg:h-[540px]">
    
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-slide-index={index}
      >
        <!-- Full-bleed background image -->
        <img 
          src={slide.image} 
          alt={slide.title} 
          class="w-full h-full object-cover object-center"
          loading={index === 0 ? "eager" : "lazy"}
        />
        
        <!-- Subtle dark gradient vignette -->
        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-black/80 via-black/45 to-transparent"></div>

        <!-- Editorial Text Overlay (Inside Max-W Container) -->
        <div class="absolute inset-0 flex items-center">
          <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 w-full">
            <div class="max-w-xl text-white space-y-2 sm:space-y-3">
              
              <!-- Clean Minimalist Text (No Badge Pill) -->
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#E3D9C6] block">
                {slide.tag}
              </span>

              <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif font-medium text-white leading-tight">
                {slide.title}
              </h2>

              <p class="text-xs sm:text-sm text-white/85 max-w-md leading-relaxed font-light line-clamp-2" set:html={slide.subtitle} />

              <div class="pt-3">
                <a 
                  href={slide.linkUrl} 
                  class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-briella-charcoal bg-white hover:bg-briella-cream active:scale-95 px-6 py-3 rounded-full transition-all shadow-md"
                >
                  <span>{slide.linkText}</span>
                  <svg class="w-4 h-4 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>

            </div>
          </div>
        </div>

      </div>
    ))}

    <!-- Prev & Next Arrows (Floating Buttons) -->
    <button 
      id="heroBtnPrev" 
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/35 hover:bg-black/55 backdrop-blur-sm text-white flex items-center justify-center transition-all focus:outline-none shadow-sm active:scale-95"
      aria-label="Slide anterior"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button 
      id="heroBtnNext" 
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/35 hover:bg-black/55 backdrop-blur-sm text-white flex items-center justify-center transition-all focus:outline-none shadow-sm active:scale-95"
      aria-label="Siguiente slide"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Pagination Dots -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      {slides.map((_, i) => (
        <button 
          class={`hero-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-7' : 'bg-white/40 w-2 hover:bg-white/70'}`}
          data-dot-index={i}
          aria-label={`Ir al slide ${i + 1}`}
        />
      ))}
    </div>

  </div>

</section>

<!-- Carousel Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    const prevBtn = document.getElementById('heroBtnPrev');
    const nextBtn = document.getElementById('heroBtnNext');
    let currentIndex = 0;
    let autoInterval = null;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove('bg-white/40', 'w-2');
          dot.classList.add('bg-white', 'w-7');
        } else {
          dot.classList.remove('bg-white', 'w-7');
          dot.classList.add('bg-white/40', 'w-2');
        }
      });
    }

    function startAuto() {
      stopAuto();
      autoInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5000);
    }

    function stopAuto() {
      if (autoInterval) clearInterval(autoInterval);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
        startAuto();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
        startAuto();
      });
    }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.dataset.dotIndex || '0', 10);
        goToSlide(idx);
        startAuto();
      });
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    const carouselEl = document.getElementById('heroCarousel');

    if (carouselEl) {
      carouselEl.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAuto();
      }, { passive: true });

      carouselEl.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 40) {
          goToSlide(currentIndex + 1);
        } else if (touchEndX - touchStartX > 40) {
          goToSlide(currentIndex - 1);
        }
        startAuto();
      }, { passive: true });
    }

    startAuto();
  });
</script>
