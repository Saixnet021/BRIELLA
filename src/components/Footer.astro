---
// src/components/Footer.astro
---

<footer id="contacto" class="bg-briella-charcoal text-white pt-14 pb-20 sm:pb-12 border-t border-briella-charcoal-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Story -->
      <div class="space-y-4">
        <a href="#" class="inline-block">
          <img 
            src="assets/images/logo-white.svg" 
            alt="SM Joyería" 
            class="h-9 w-auto object-contain" 
            width="170" 
            height="40"
          />
        </a>
        <p class="text-xs text-white/70 leading-relaxed max-w-sm">
          Joyería SM &bull; Ofrecemos joyas personalizadas en Oro 18kts y Plata 950 ley garantizándoles una increíble experiencia artesanal con envíos seguros a todo el Perú.
        </p>
        <div class="flex items-center gap-2.5 pt-2">
          <!-- Facebook -->
          <a 
            href="https://www.facebook.com/profile.php?id=61563982505831" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white/80 hover:text-white hover:bg-briella-purple hover:border-briella-purple transition-all text-xs active:scale-95"
            aria-label="Facebook Oficial"
            title="Facebook Oficial"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/smj_oyeria?igsh=MXhnYnpvZDVsMTZwZQ==" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white/80 hover:text-white hover:bg-briella-rose hover:border-briella-rose transition-all text-xs active:scale-95"
            aria-label="Instagram Oficial"
            title="Instagram Oficial"
          >
            <svg class="w-4 h-4 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- TikTok -->
          <a 
            href="https://www.tiktok.com/@sm.joyeria?_r=1&_t=ZS-95IQ9N1KKOb" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white/80 hover:text-white hover:bg-white/20 transition-all text-xs active:scale-95"
            aria-label="TikTok Oficial"
            title="TikTok Oficial"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.46v-7.14a8.16 8.16 0 0 0 5.77 2.3v-3.5a4.78 4.78 0 0 1-3.5-1.42 4.7 4.7 0 0 1-.5-3.67z"/>
            </svg>
          </a>

          <!-- WhatsApp Channel -->
          <a 
            href="https://whatsapp.com/channel/0029VbCnZ3423n3aFVXEXn1w" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white/80 hover:text-white hover:bg-briella-whatsapp hover:border-briella-whatsapp transition-all text-xs active:scale-95"
            aria-label="Canal de WhatsApp"
            title="Canal de Difusión WhatsApp"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7.0 8.98 7.0 10.21C7.0 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Collections -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-luxury text-white mb-4">Colecciones</h4>
        <ul class="space-y-2.5 text-xs text-white/70">
          <li><a href="#catalogo" class="hover:text-briella-rose transition-colors">Aretes de Plata Ley 950</a></li>
          <li><a href="#catalogo" class="hover:text-briella-rose transition-colors">Collares &amp; Cadenas</a></li>
          <li><a href="#catalogo" class="hover:text-briella-rose transition-colors">Pulseras &amp; Tobilleras</a></li>
          <li><a href="#catalogo" class="hover:text-briella-rose transition-colors">Anillos &amp; Solitarios</a></li>
          <li><a href="#personalizados" class="text-briella-rose hover:text-white transition-colors font-semibold">Joyas con Nombre Personalizado</a></li>
          <li><a href="#catalogo" class="hover:text-briella-rose transition-colors">Colección Oro 18k</a></li>
        </ul>
      </div>

      <!-- Ubicación y Taller -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-luxury text-white mb-4">Taller &amp; Ubicación</h4>
        <ul class="space-y-3 text-xs text-white/70">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-briella-rose flex-shrink-0 mt-0.5 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div>
              <span class="block text-[11px] text-white/50">Dirección:</span>
              <span class="text-white font-medium">Comercio 649, Catacaos 20006, Piura, Perú</span>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-briella-rose flex-shrink-0 mt-0.5 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <div>
              <span class="block text-[11px] text-white/50">Correo Electrónico:</span>
              <a href="mailto:sm.joyeria2@gmail.com" class="text-white font-medium hover:text-briella-rose transition-colors">
                sm.joyeria2@gmail.com
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-briella-rose flex-shrink-0 mt-0.5 stroke-[1.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="block text-[11px] text-white/50">Horario de Atención:</span>
              <span class="text-white font-medium">Lun - Sáb: 10:00 AM - 7:00 PM</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Customer Service & WhatsApp -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-luxury text-white mb-4">Atención al Cliente</h4>
        <ul class="space-y-3 text-xs text-white/70">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-briella-whatsapp flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.04 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15M16.57 14.45C16.32 14.32 15.1 13.72 14.87 13.64C14.64 13.55 14.48 13.51 14.31 13.76C14.15 14.01 13.67 14.57 13.52 14.73C13.38 14.9 13.23 14.92 12.98 14.8C12.73 14.67 11.93 14.41 10.98 13.57C10.24 12.91 9.74 12.1 9.6 11.85C9.45 11.6 9.58 11.47 9.71 11.34C9.82 11.23 9.96 11.05 10.09 10.91C10.21 10.76 10.26 10.66 10.34 10.5C10.42 10.33 10.38 10.19 10.32 10.07C10.26 9.94 9.77 8.74 9.56 8.25C9.36 7.76 9.16 7.83 9.01 7.82C8.87 7.81 8.71 7.81 8.54 7.81C8.38 7.81 8.11 7.87 7.88 8.12C7.65 8.37 7.0 8.98 7.0 10.21C7.0 11.44 7.9 12.63 8.02 12.79C8.15 12.96 9.78 15.47 12.28 16.55C12.87 16.81 13.33 16.96 13.69 17.07C14.29 17.26 14.83 17.23 15.26 17.17C15.74 17.1 16.74 16.57 16.95 15.99C17.15 15.41 17.15 14.92 17.09 14.8C17.03 14.7 16.82 14.57 16.57 14.45Z"/>
            </svg>
            <div>
              <span class="block text-[11px] text-white/50">WhatsApp Oficial:</span>
              <a href="https://wa.me/51984018633" target="_blank" rel="noopener noreferrer" class="text-white font-bold hover:text-briella-whatsapp transition-colors">
                +51 984 018 633
              </a>
            </div>
          </li>
          <li>
            <a 
              href="https://whatsapp.com/channel/0029VbCnZ3423n3aFVXEXn1w" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-briella-purple text-xs font-semibold text-white transition-all mt-1"
            >
              <span>Canal de Difusión</span>
              <svg class="w-3.5 h-3.5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-white/50">
      <div>
        &copy; {new Date().getFullYear()} SM Joyería. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-2">
        <span>Medios de pago:</span>
        <span class="px-2.5 py-0.5 bg-white/10 text-white rounded-full text-[10px]">Yape</span>
        <span class="px-2.5 py-0.5 bg-white/10 text-white rounded-full text-[10px]">Plin</span>
        <span class="px-2.5 py-0.5 bg-white/10 text-white rounded-full text-[10px]">BCP</span>
        <span class="px-2.5 py-0.5 bg-white/10 text-white rounded-full text-[10px]">BBVA</span>
      </div>
    </div>

  </div>
</footer>
